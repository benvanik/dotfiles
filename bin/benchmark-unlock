#!/bin/bash
# Recover machine-level knobs saved by the retired snapshot-style lock.
#
# This command exists only for historical /tmp/benchmark-lock-* state. The
# current benchmark-lock is process-scoped and needs no matching unlock.

set -euo pipefail

USER_NAME="${SUDO_USER:-${USER:-$(id -un 2>/dev/null || id -u)}}"
STATE_DIR="${BENCHMARK_LOCK_STATE_DIR:-/tmp/benchmark-lock-$USER_NAME}"
STATE_FILE="$STATE_DIR/state.tsv"
LEGACY_ROOT_STATE_DIR="${BENCHMARK_LOCK_LEGACY_STATE_DIR:-/tmp/benchmark-lock-root}"
LEGACY_ROOT_STATE_FILE="$LEGACY_ROOT_STATE_DIR/state.tsv"
STATE_OWNER_UID="${SUDO_UID:-$(id -u)}"
STATE_OWNER_GID="${SUDO_GID:-$(id -g)}"
SCRIPT_DIR="$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/benchmark-transaction.sh
source "$SCRIPT_DIR/../lib/benchmark-transaction.sh"
RESTORE_KINDS=()
RESTORE_PATHS=()
RESTORE_VALUES=()

GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}[benchmark-unlock]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[benchmark-unlock]${NC} %s\n" "$1"; }
error() { printf "${RED}[benchmark-unlock]${NC} %s\n" "$1" >&2; }

benchmark_acquire_transaction_guard \
    "$STATE_DIR" "$STATE_OWNER_UID" "$STATE_OWNER_GID"

sudo_write() {
    local value="$1"
    local path="$2"
    printf '%s\n' "$value" | sudo tee "$path" >/dev/null
}

read_root_state() {
    local source_path="$1"
    local destination_path="$2"

    # sudo is required for the source; the destination is a user-owned mktemp.
    # shellcheck disable=SC2024
    sudo cat "$source_path" > "$destination_path"
}

validate_saved_value_token() {
    [[ "$1" =~ ^[A-Za-z0-9_.+-]+$ ]]
}

validate_saved_state_record() {
    local kind="$1"
    local path="$2"
    local value="$3"
    local available_path=""

    case "$kind" in
        aslr)
            [ "$path" = "/proc/sys/kernel/randomize_va_space" ] &&
                [[ "$value" =~ ^[012]$ ]]
            ;;
        cpu_governor)
            [[ "$path" =~ ^/sys/devices/system/cpu/cpufreq/policy[0-9]+/scaling_governor$ ]] ||
                return 1
            validate_saved_value_token "$value" || return 1
            available_path="${path%/*}/scaling_available_governors"
            [ ! -r "$available_path" ] ||
                grep -qw -- "$value" "$available_path"
            ;;
        cpu_energy_preference)
            [[ "$path" =~ ^/sys/devices/system/cpu/cpufreq/policy[0-9]+/energy_performance_preference$ ]] ||
                return 1
            validate_saved_value_token "$value" || return 1
            available_path="${path%/*}/energy_performance_available_preferences"
            [ ! -r "$available_path" ] ||
                grep -qw -- "$value" "$available_path"
            ;;
        amdgpu_dpm)
            [[ "$path" =~ ^/sys/class/drm/card[0-9]+/device/power_dpm_force_performance_level$ ]] ||
                return 1
            case "$value" in
                auto|low|high|manual|profile_*) return 0 ;;
                *) return 1 ;;
            esac
            ;;
        *) return 1 ;;
    esac
}

load_saved_state_records() {
    local state_path="$1"
    local kind=""
    local path=""
    local value=""
    local extra=""

    RESTORE_KINDS=()
    RESTORE_PATHS=()
    RESTORE_VALUES=()
    while IFS=$'\t' read -r kind path value extra; do
        if [ -z "${kind:-}" ] && [ -z "${path:-}" ] &&
                [ -z "${value:-}" ] && [ -z "${extra:-}" ]; then
            continue
        fi
        if [ -n "${extra:-}" ] ||
                ! validate_saved_state_record "$kind" "$path" "$value"; then
            error "Refusing invalid benchmark state record: $kind $path"
            return 1
        fi
        RESTORE_KINDS+=("$kind")
        RESTORE_PATHS+=("$path")
        RESTORE_VALUES+=("$value")
    done < "$state_path"
    if [ "${#RESTORE_KINDS[@]}" -eq 0 ]; then
        error "Benchmark state contains no restorable records: $state_path"
        return 1
    fi
}

describe_path() {
    local path="$1"
    if [[ -e "$path" ]]; then
        stat -c '%U:%G mode=%a %n' "$path" 2>/dev/null || ls -ld "$path"
    else
        printf '%s (missing)\n' "$path"
    fi
}

state_dir_entries() {
    if [[ ! -d "$STATE_DIR" || ! -r "$STATE_DIR" || ! -x "$STATE_DIR" ]]; then
        return 0
    fi
    find "$STATE_DIR" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null
}

print_lock_status() {
    if [[ -f "$STATE_FILE" && -r "$STATE_FILE" ]]; then
        info "Benchmark lock is active: $STATE_FILE"
        return 0
    fi
    if [[ -e "$STATE_FILE" && ! -r "$STATE_FILE" ]]; then
        warn "Benchmark lock state exists but is not readable:"
        warn "  $(describe_path "$STATE_FILE")"
        return 2
    fi
    if [[ -e "$STATE_DIR" ]]; then
        if [[ ! -d "$STATE_DIR" ]]; then
            warn "Benchmark lock state path exists but is not a directory:"
            warn "  $(describe_path "$STATE_DIR")"
            return 2
        fi
        if [[ ! -r "$STATE_DIR" || ! -x "$STATE_DIR" ]]; then
            warn "Benchmark lock state directory exists but is not usable:"
            warn "  $(describe_path "$STATE_DIR")"
            return 2
        fi
        if [[ -n "$(state_dir_entries)" ]]; then
            warn "Benchmark lock state directory exists without $STATE_FILE:"
            warn "  $(describe_path "$STATE_DIR")"
            return 2
        fi
    fi
    if [[ -e "$LEGACY_ROOT_STATE_DIR" && "$STATE_DIR" != "$LEGACY_ROOT_STATE_DIR" ]]; then
        warn "Legacy root-owned benchmark lock may be active: $LEGACY_ROOT_STATE_DIR"
        return 2
    fi
    info "Benchmark lock is not active."
    return 0
}

if [[ "${1:-}" == "--status" ]]; then
    status_code=0
    print_lock_status || status_code=$?
    exit "$status_code"
fi

sudo -v

RESTORE_STATE_FILE="$STATE_FILE"
TEMP_RESTORE_STATE=""
RESTORE_LEGACY_ROOT_STATE=0
RESTORE_ROOT_OWNED_STATE=0
cleanup_restore_temp() {
    if [[ -n "$TEMP_RESTORE_STATE" &&
            ( -f "$TEMP_RESTORE_STATE" || -L "$TEMP_RESTORE_STATE" ) ]]; then
        unlink "$TEMP_RESTORE_STATE"
    fi
}
trap cleanup_restore_temp EXIT

if [[ ! -r "$RESTORE_STATE_FILE" ]]; then
    if [[ -e "$STATE_FILE" ]]; then
        TEMP_RESTORE_STATE="$(mktemp)"
        if read_root_state "$STATE_FILE" "$TEMP_RESTORE_STATE"; then
            RESTORE_STATE_FILE="$TEMP_RESTORE_STATE"
            RESTORE_ROOT_OWNED_STATE=1
            warn "Restoring root-owned benchmark lock: $STATE_FILE"
        else
            unlink "$TEMP_RESTORE_STATE"
            error "Could not read benchmark lock state: $STATE_FILE"
            exit 1
        fi
    elif [[ -e "$STATE_DIR" && ( ! -r "$STATE_DIR" || ! -x "$STATE_DIR" ) ]]; then
        TEMP_RESTORE_STATE="$(mktemp)"
        if read_root_state "$STATE_FILE" "$TEMP_RESTORE_STATE"; then
            RESTORE_STATE_FILE="$TEMP_RESTORE_STATE"
            RESTORE_ROOT_OWNED_STATE=1
            warn "Restoring sudo-created benchmark lock: $STATE_FILE"
        else
            unlink "$TEMP_RESTORE_STATE"
            error "Benchmark lock state directory is present but not readable:"
            error "  $(describe_path "$STATE_DIR")"
            error "Could not read $STATE_FILE with sudo; inspect it before removing it."
            exit 1
        fi
    elif [[ -e "$STATE_DIR" ]]; then
        if [[ ! -d "$STATE_DIR" || ! -r "$STATE_DIR" || ! -x "$STATE_DIR" ||
              -n "$(state_dir_entries)" ]]; then
            error "Benchmark lock state directory is present but has no readable state.tsv:"
            error "  $(describe_path "$STATE_DIR")"
            error "Inspect it before removing it."
            exit 1
        fi
        info "Benchmark lock is not active; removing empty state directory."
        rmdir "$STATE_DIR" 2>/dev/null || true
        exit 0
    else
        RESTORE_STATE_FILE="$STATE_FILE"
    fi
fi
if [[ ! -r "$RESTORE_STATE_FILE" ]]; then
    if [[ -e "$LEGACY_ROOT_STATE_DIR" && "$STATE_DIR" != "$LEGACY_ROOT_STATE_DIR" ]]; then
        TEMP_RESTORE_STATE="$(mktemp)"
        if read_root_state "$LEGACY_ROOT_STATE_FILE" "$TEMP_RESTORE_STATE"; then
            RESTORE_STATE_FILE="$TEMP_RESTORE_STATE"
            RESTORE_LEGACY_ROOT_STATE=1
            warn "Restoring legacy root-owned benchmark lock: $LEGACY_ROOT_STATE_FILE"
        else
            unlink "$TEMP_RESTORE_STATE"
            error "Could not read legacy root-owned state: $LEGACY_ROOT_STATE_FILE"
            exit 1
        fi
    else
        info "Benchmark lock is not active; nothing to restore."
        exit 0
    fi
fi

# The snapshot is user-owned for recoverability, so its contents are data, not
# write authority. Parse and validate the complete record set once before the
# first sudo tee. Privileged writes consume only these in-memory records; the
# user-writable pathname is never reopened as authority.
if ! load_saved_state_records "$RESTORE_STATE_FILE"; then
    error "Keeping benchmark lock state for inspection: $RESTORE_STATE_FILE"
    exit 1
fi

failure_count=0
for ((record_index = 0;
        record_index < ${#RESTORE_KINDS[@]};
        record_index++)); do
    kind="${RESTORE_KINDS[$record_index]}"
    path="${RESTORE_PATHS[$record_index]}"
    value="${RESTORE_VALUES[$record_index]}"
    if [[ ! -e "$path" ]]; then
        warn "Saved $kind path no longer exists: $path"
        continue
    fi
    if sudo_write "$value" "$path"; then
        info "Restored $kind: $path = $value"
    else
        warn "Failed to restore $kind: $path = $value"
        failure_count=$((failure_count + 1))
    fi
done

if [[ "$failure_count" -ne 0 ]]; then
    error "Restore had $failure_count failure(s); keeping $STATE_FILE for retry."
    exit 1
fi

if [[ "$RESTORE_LEGACY_ROOT_STATE" -eq 0 ]]; then
    if [[ "$RESTORE_ROOT_OWNED_STATE" -ne 0 ]]; then
        sudo unlink "$STATE_FILE"
    else
        unlink "$STATE_FILE"
    fi
fi
if [[ "$RESTORE_LEGACY_ROOT_STATE" -ne 0 ]]; then
    sudo unlink "$LEGACY_ROOT_STATE_FILE"
    sudo rmdir "$LEGACY_ROOT_STATE_DIR" 2>/dev/null || true
fi
if [[ -n "$TEMP_RESTORE_STATE" &&
        ( -f "$TEMP_RESTORE_STATE" || -L "$TEMP_RESTORE_STATE" ) ]]; then
    unlink "$TEMP_RESTORE_STATE"
    TEMP_RESTORE_STATE=""
fi
if [[ "$RESTORE_ROOT_OWNED_STATE" -ne 0 ]]; then
    sudo rmdir "$STATE_DIR" 2>/dev/null || true
else
    rmdir "$STATE_DIR" 2>/dev/null || true
fi
info "Benchmark lock released."
