#!/bin/bash
# Run IREE tests with Bazel.
#
# Usage: iree-bazel-test [options] [target] [bazel-args...]
#
# Examples:
#   iree-bazel-test                       # Run all tests (CPU only)
#   iree-bazel-test //compiler/...        # Test compiler only
#   iree-bazel-test --config=asan         # Test with AddressSanitizer

set -e

# Source shared library.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/iree-bazel-lib"
iree_bazel_init "iree-bazel-test"

# Expand combined short flags (e.g., -nv -> -n -v).
eval "set -- $(iree_expand_combined_flags "$@")"

show_help() {
    cat << 'EOF'
iree-bazel-test - Run IREE tests with Bazel

USAGE
    iree-bazel-test [options] [target] [bazel-args...]

OPTIONS
    -n, --dry_run    Show the bazel command without executing
    -v, --verbose    Show the bazel command before executing
    -h, --help       Show this help

    Note: --keep_going is always enabled for test runs.

ARGUMENTS
    target       Bazel target (default: //...)
    bazel-args   Additional arguments passed to bazel test

EXAMPLES
    iree-bazel-test                       # Run all tests (CPU only)
    iree-bazel-test //compiler/...        # Test compiler only
    iree-bazel-test --config=asan         # Test with AddressSanitizer
    iree-bazel-test -nv //runtime/...     # Show what would run

DEFAULT BEHAVIOR
    - Excludes GPU tests (CUDA, Vulkan, HIP, Metal) by default
    - Continues on test failures (--keep_going)

ENABLING GPU TESTS
    Set environment variables to 0 to ENABLE:
    IREE_VULKAN_DISABLE=0 iree-bazel-test     # Include Vulkan tests
    IREE_CUDA_DISABLE=0 iree-bazel-test       # Include CUDA tests
    IREE_HIP_DISABLE=0 iree-bazel-test        # Include HIP tests

CONFIGURATIONS
    --config=localdev        Local dev optimizations (disk cache, skymeld)
    --config=debug           Debug build tests
    --config=asan            Address Sanitizer
    --config=msan            Memory Sanitizer
    --config=tsan            Thread Sanitizer

SEE ALSO
    iree-bazel-configure, iree-bazel-build
EOF
}

# Parse arguments.
TARGET=""
BAZEL_ARGS=()

while [[ $# -gt 0 ]]; do
    case "$1" in
        -h|--help)
            show_help
            exit 0
            ;;
        --agent-md)
            iree_show_agent_md
            exit 0
            ;;
        -n|--dry_run|--dry-run)
            IREE_BAZEL_DRY_RUN=1
            shift
            ;;
        -v|--verbose)
            IREE_BAZEL_VERBOSE=1
            shift
            ;;
        -*)
            BAZEL_ARGS+=("$1")
            shift
            ;;
        *)
            if [[ -z "$TARGET" ]]; then
                TARGET="$1"
            else
                BAZEL_ARGS+=("$1")
            fi
            shift
            ;;
    esac
done

# Set up worktree (after arg parsing so --help works anywhere).
iree_setup_worktree

# Default target.
TARGET="${TARGET:-//...}"

# Build tag filters based on environment.
TAG_FILTERS="-nodocker"
BUILD_FILTERS=""

# GPU/hardware test filtering (disabled by default).
CUDA_DISABLE="${IREE_CUDA_DISABLE:-1}"
VULKAN_DISABLE="${IREE_VULKAN_DISABLE:-1}"
HIP_DISABLE="${IREE_HIP_DISABLE:-1}"
METAL_DISABLE="${IREE_METAL_DISABLE:-1}"

if [[ "$CUDA_DISABLE" == "1" ]]; then
    TAG_FILTERS="$TAG_FILTERS,-driver=cuda,-target=cuda"
    BUILD_FILTERS="$BUILD_FILTERS,-driver=cuda,-target=cuda"
fi
if [[ "$VULKAN_DISABLE" == "1" ]]; then
    TAG_FILTERS="$TAG_FILTERS,-driver=vulkan"
    BUILD_FILTERS="$BUILD_FILTERS,-driver=vulkan"
fi
if [[ "$HIP_DISABLE" == "1" ]]; then
    TAG_FILTERS="$TAG_FILTERS,-driver=hip"
    BUILD_FILTERS="$BUILD_FILTERS,-driver=hip"
fi
if [[ "$METAL_DISABLE" == "1" ]]; then
    TAG_FILTERS="$TAG_FILTERS,-driver=metal"
    BUILD_FILTERS="$BUILD_FILTERS,-driver=metal"
fi

# Build the command with default configs before user args.
iree_bazel_build_default_configs
CMD=(bazel test "${IREE_BAZEL_DEFAULT_CONFIGS[@]}" --keep_going "$TARGET"
    --test_tag_filters="$TAG_FILTERS"
    --build_tag_filters="$BUILD_FILTERS"
    "${BAZEL_ARGS[@]}")

# Execute or show.
if iree_is_verbose || iree_is_dry_run; then
    iree_info "Command: ${CMD[*]}"
fi

if iree_is_dry_run; then
    exit 0
fi

iree_info "Testing $TARGET"
iree_info "Tag filters: $TAG_FILTERS"
exec "${CMD[@]}"
