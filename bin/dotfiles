#!/bin/bash
# ~/.dotfiles/bin/dotfiles - Unified dotfiles management CLI
# Provides testing and installation commands.
set -e

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"

# Colors.
RED=$'\033[0;31m'
GREEN=$'\033[0;32m'
YELLOW=$'\033[0;33m'
BOLD=$'\033[1m'
NC=$'\033[0m'

info() { printf "${GREEN}[dotfiles]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[dotfiles]${NC} %s\n" "$1"; }
error() { printf "${RED}[dotfiles]${NC} %s\n" "$1" >&2; }

_resolve_dotfiles_implementation_root() {
    local entrypoint="${BASH_SOURCE[0]}"
    local entrypoint_directory=""
    local entrypoint_target=""
    local link_count=0

    while [ -L "$entrypoint" ]; do
        link_count=$((link_count + 1))
        if [ "$link_count" -gt 40 ]; then
            error "Too many symlinks while resolving dotfiles entrypoint"
            return 1
        fi
        if ! entrypoint_directory=$(
                CDPATH='' cd -- "$(dirname -- "$entrypoint")" && pwd -P
            ) ||
                ! entrypoint_target=$(readlink "$entrypoint"); then
            error "Could not resolve dotfiles entrypoint: $entrypoint"
            return 1
        fi
        case "$entrypoint_target" in
            /*) entrypoint="$entrypoint_target" ;;
            *) entrypoint="$entrypoint_directory/$entrypoint_target" ;;
        esac
    done

    if ! entrypoint_directory=$(
            CDPATH='' cd -- "$(dirname -- "$entrypoint")" && pwd -P
        ); then
        error "Could not resolve dotfiles implementation directory"
        return 1
    fi
    (
        CDPATH=''
        cd -- "$entrypoint_directory/.." && pwd -P
    )
}

if ! DOTFILES_IMPLEMENTATION_ROOT=$(
        _resolve_dotfiles_implementation_root
    ); then
    exit 1
fi
unset -f _resolve_dotfiles_implementation_root

# ============================================================================
# Help
# ============================================================================
show_help() {
    cat << EOF
${BOLD}dotfiles${NC} - Unified dotfiles management CLI

${BOLD}USAGE${NC}
    dotfiles <command> [options]

${BOLD}COMMANDS${NC}
    ${BOLD}test${NC}              Run Tier 1 fast local tests
    ${BOLD}test --full${NC}       Run Tier 1 + Tier 2 Docker tests
    ${BOLD}doctor${NC}            Health check (tools, symlinks, configs)
    ${BOLD}fixup${NC}             Integrate installer changes to shell configs
    ${BOLD}update${NC}            Pull changes and publish agent contracts
    ${BOLD}install${NC}           Set up dotfiles (deps check, symlinks, identity)
    ${BOLD}deps${NC}              Run install-deps.sh (install packages)
    ${BOLD}multiplexer${NC}       Update official tmux, Byobu, TPM, and plugins
    ${BOLD}setup${NC}             Configure git SSH signing
    ${BOLD}help${NC}              Show this help

${BOLD}EXAMPLES${NC}
    dotfiles test             # Quick validation after editing
    dotfiles test --full      # Full Docker-based integration test

${BOLD}TESTING${NC}
    Tier 1 (fast, local):
      - Shell syntax validation (bash, zsh, POSIX)
      - Symlink target verification
      - POSIX compliance checks
      - Secret detection
      - shellcheck (if installed)

    Tier 2 (Docker, comprehensive):
      - Full install on pristine Ubuntu
      - Package installation validation
      - Interactive shell startup tests
EOF
}

# ============================================================================
# Test Command
# ============================================================================
cmd_test() {
    local full=false

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --full) full=true; shift ;;
            *) error "Unknown option: $1"; exit 1 ;;
        esac
    done

    # Always run Tier 1.
    if ! "$DOTFILES/test/run-tier1.sh"; then
        error "Tier 1 tests failed"
        exit 1
    fi

    # Run Tier 2 if requested.
    if $full; then
        echo ""
        if command -v docker &>/dev/null; then
            "$DOTFILES/test/run-tier2.sh"
        else
            warn "Docker not available - skipping Tier 2 tests"
            warn "Install Docker for full integration testing"
        fi
    fi
}

# ============================================================================
# Install Command
# ============================================================================
cmd_install() {
    local configured_bazel_cache_root=""

    # Step 1: Check dependencies (no sudo from here).
    info "Checking dependencies..."
    if ! "$DOTFILES/install-deps.sh" --verify 2>/dev/null; then
        echo ""
        error "Missing required packages. Install them first:"
        echo ""
        echo "    ~/.dotfiles/install-deps.sh"
        echo ""
        exit 1
    fi
    echo ""

    # Step 2: Check shell components.
    _check_shell_components

    # Step 3: Create ~/.shrc.local template if missing.
    _ensure_shrc_local

    # Step 4: Configure machine-local Bazel placement when requested.
    if configured_bazel_cache_root=$(bazel_cache_configured_root); then
        info "Configuring machine-local Bazel cache placement..."
        bazel_cache_configure "$configured_bazel_cache_root"
    else
        warn "BAZEL_CACHE_ROOT is unset; Bazel cache placement was not configured"
    fi

    # Step 5: Prompt for identity if needed and interactive.
    if _needs_identity && _is_interactive; then
        echo ""
        _prompt_identity
    fi

    # Step 6: Create symlinks.
    _create_symlinks

    # Step 7: Generate ~/.gitconfig.local.
    _generate_gitconfig_local

    # Step 8: Set up git SSH signing.
    _setup_git_signing

    # Step 9: Create ~/.secrets template if missing.
    _ensure_secrets

    # Step 10: Show summary.
    _show_summary
}

# Publication implementation follows the loaded command, not the independently
# selectable DOTFILES content root. Tests and recovery tools intentionally pair
# one implementation checkout with another managed source generation.
# shellcheck source=../lib/home-publication-transaction.sh
source "$DOTFILES_IMPLEMENTATION_ROOT/lib/home-publication-transaction.sh"
# shellcheck source=../lib/managed-link-publication.sh
source "$DOTFILES_IMPLEMENTATION_ROOT/lib/managed-link-publication.sh"
# shellcheck source=../lib/managed-copy-publication.sh
source "$DOTFILES_IMPLEMENTATION_ROOT/lib/managed-copy-publication.sh"
# shellcheck source=../lib/agent-contract-publication.sh
source "$DOTFILES_IMPLEMENTATION_ROOT/lib/agent-contract-publication.sh"
# shellcheck source=../lib/local-config-publication.sh
source "$DOTFILES_IMPLEMENTATION_ROOT/lib/local-config-publication.sh"
# shellcheck source=../lib/bazel-cache.sh
source "$DOTFILES_IMPLEMENTATION_ROOT/lib/bazel-cache.sh"

_link() {
    _link_path "$DOTFILES/$1" "$HOME/$2"
}

_install_pre_commit_hook() {
    if [ ! -d "$DOTFILES/.git" ]; then
        return 0
    fi

    info "Setting up pre-commit hook..."
    _link_path \
        "$DOTFILES/git/hooks/pre-commit" \
        "$DOTFILES/.git/hooks/pre-commit"
}

# Create all symlinks.
_create_symlinks() {
    info "Setting up shell configuration..."
    _link shell/zshrc .zshrc
    _link shell/zshrc.d .zshrc.d
    _link shell/shrc .shrc
    _link shell/aliases .aliases
    _link shell/bashrc .bashrc
    _link shell/profile .profile

    info "Setting up prompt themes..."
    _link themes/p10k.zsh .p10k.zsh
    for theme in "$DOTFILES"/themes/p10k-*.zsh; do
        [ -f "$theme" ] && _link "themes/$(basename "$theme")" ".$(basename "$theme")"
    done

    info "Setting up git configuration..."
    _link git/config .gitconfig
    _link git/ignore_global .gitignore_global

    # Set up the repository-local pre-commit hook through the same preserving
    # publisher as HOME links.
    _install_pre_commit_hook

    info "Setting up Claude configuration..."
    _mkdir_p_durable "$HOME/.claude"
    _link claude/settings.json .claude/settings.json
    _link claude/settings-admin.json .claude/settings-admin.json
    _link claude/statusline.sh .claude/statusline.sh
    _link claude/claude-powerline.json .claude/claude-powerline.json

    # GPU passthrough wrapper for Claude Code sandbox (Linux only).
    if [ "$(uname -s)" = "Linux" ] && command -v bwrap &>/dev/null; then
        info "Setting up Claude sandbox GPU passthrough..."
        _link claude/bwrap-gpu-wrapper .local/bin/bwrap
    fi

    info "Setting up Codex configuration..."
    _publish_agent_contracts

    info "Setting up tmux configuration..."
    _link tmux.conf .tmux.conf

    info "Setting up versioned tools..."
    _link tools/CLAUDE.md tools/CLAUDE.md
    _link tools/README.md tools/README.md
    _link tools/direnvrc .direnvrc

    info "Setting up direnv configuration..."
    _link direnv/direnv.toml .config/direnv/direnv.toml
}

_render_gitconfig_local() {
    local output_path="$1"
    local user_name="$2"
    local user_email="$3"

    cat > "$output_path" << 'EOF'
# ~/.gitconfig.local - Machine-specific git configuration (NOT synced)
# Generated from USER_NAME and USER_EMAIL in ~/.shrc.local

EOF
    if ! git config --file "$output_path" --add user.name "$user_name" ||
            ! git config --file "$output_path" --add user.email "$user_email"; then
        return 1
    fi
}

_render_gitconfig_local_placeholder() {
    local output_path="$1"

    cat > "$output_path" << 'EOF'
# ~/.gitconfig.local - Machine-specific git configuration (NOT synced)
# Edit ~/.shrc.local with your identity, then re-run 'dotfiles install'.

[user]
    name = Your Name
    email = you@example.com
EOF
}

# Generate ~/.gitconfig.local from identity in ~/.shrc.local.
_generate_gitconfig_local_locked() {
    local destination="$HOME/.gitconfig.local"
    local shrc_local="$HOME/.shrc.local"
    local USER_NAME=""
    local USER_EMAIL=""

    if [ -L "$destination" ]; then
        error "Refusing symlinked local configuration: $destination"
        return 1
    fi
    if [ -e "$destination" ]; then
        if [ ! -f "$destination" ]; then
            error "Local configuration is not a regular file: $destination"
            return 1
        fi
        return 0
    fi

    if [ -L "$shrc_local" ]; then
        error "Refusing symlinked local configuration: $shrc_local"
        return 1
    fi
    if [ -e "$shrc_local" ] && [ ! -f "$shrc_local" ]; then
        error "Local configuration is not a regular file: $shrc_local"
        return 1
    fi
    if [ -f "$shrc_local" ]; then
        # shellcheck source=/dev/null
        . "$shrc_local"
    fi

    if [ -n "$USER_NAME" ] && [ "$USER_NAME" != "Your Name" ] &&
            [ -n "$USER_EMAIL" ] && [ "$USER_EMAIL" != "you@example.com" ]; then
        info "Creating ~/.gitconfig.local with user identity..."
        _create_local_file_locked \
            "$destination" 644 _render_gitconfig_local \
            "$USER_NAME" "$USER_EMAIL"
    else
        info "Creating ~/.gitconfig.local template..."
        _create_local_file_locked \
            "$destination" 644 _render_gitconfig_local_placeholder
        warn "Set USER_NAME/USER_EMAIL in ~/.shrc.local, then re-run 'dotfiles install'"
    fi
}

_generate_gitconfig_local() {
    _with_home_transaction_lock _generate_gitconfig_local_locked
}

# Set up git SSH signing and ensure local verification is configured.
_setup_git_signing() {
    local configured_signing_key=""
    configured_signing_key=$(
        git config --global --includes user.signingkey 2>/dev/null
    ) || configured_signing_key=""

    if [ -n "$configured_signing_key" ] ||
            { [ -d "$HOME/.ssh" ] &&
                compgen -G "$HOME/.ssh/*.pub" >/dev/null; }; then
        info "Setting up git SSH signing..."
        "$DOTFILES/bin/git-setup-signing"
    else
        warn "No SSH keys found - run 'dotfiles setup' after creating keys"
    fi
}

# Copy a repository template into a staged local file.
_render_local_file_from_source() {
    local output_path="$1"
    local source_path="$2"

    if [ ! -f "$source_path" ] || [ -L "$source_path" ]; then
        error "Local configuration template is not a real regular file: $source_path"
        return 1
    fi
    cp "$source_path" "$output_path"
}

# Create ~/.secrets template if it doesn't exist.
_ensure_secrets_locked() {
    local destination="$HOME/.secrets"

    if [ -L "$destination" ]; then
        error "Refusing symlinked local configuration: $destination"
        return 1
    fi
    if [ -e "$destination" ]; then
        if [ ! -f "$destination" ]; then
            error "Local configuration is not a regular file: $destination"
            return 1
        fi
        return 0
    fi

    info "Creating ~/.secrets template..."
    _create_local_file_locked \
        "$destination" 600 _render_local_file_from_source \
        "$DOTFILES/secrets.template"
    warn "Created ~/.secrets - edit with your API keys"
}

_ensure_secrets() {
    _with_home_transaction_lock _ensure_secrets_locked
}

# Show install summary.
_show_summary() {
    echo ""
    info "====================================="
    info "Dotfiles installation complete!"
    info "====================================="
    echo ""

    # Show initial setup steps only if identity not configured.
    if _needs_identity; then
        info "Initial setup:"
        info "  1. Edit ~/.shrc.local with your identity (USER_NAME, USER_EMAIL)"
        info "  2. Re-run 'dotfiles install' to generate ~/.gitconfig.local"
        info "  3. Run 'dotfiles setup' to configure SSH commit signing"
        info "  4. Edit ~/.secrets with your API keys"
        info "  5. Restart your shell or run: source ~/.zshrc"
        echo ""
    else
        info "Restart your shell or run: source ~/.zshrc"
        echo ""
    fi

    info "Project workflow:"
    info "  project-init      Bootstrap project repository and .envrc"
    info "  project-dev       Create/attach to project tmux session"
    info "  project-code      Launch VS Code for project"
    info "  project-deinit    Remove project .envrc"
    info "  project-worktree-init <branch>  Create sibling Git worktree"
    info "  project-worktree-deinit <name>  Safely remove sibling worktree"
    echo ""

    if [ -d "$BACKUP_DIR" ]; then
        warn "Existing files backed up to: $BACKUP_DIR"
    fi
}

# Check if shell components are installed.
_check_shell_components() {
    local missing=()

    [ -d "$HOME/.oh-my-zsh" ] || missing+=("Oh My Zsh")
    [ -d "$HOME/.local/p10k" ] || missing+=("Powerlevel10k")
    [ -d "$HOME/.tmux/plugins/tpm" ] || missing+=("TPM (Tmux Plugin Manager)")
    [ -d "$HOME/.nvm" ] || missing+=("NVM")

    if [ ${#missing[@]} -gt 0 ]; then
        warn "Shell components not installed:"
        for component in "${missing[@]}"; do
            echo "  - $component"
        done
        echo ""
        warn "Run: ~/.dotfiles/install-deps.sh"
        echo ""
    fi
}

_render_shrc_local_template() {
    local output_path="$1"

    cat > "$output_path" << 'EOF'
# ~/.shrc.local - Machine-specific shell configuration (NOT synced)
#
# ============================================================================
# User Identity (REQUIRED - used by git and scripts)
# ============================================================================
export USER_NAME="Your Name"
export USER_EMAIL="you@example.com"
export USER_GITHUB_ID="yourusername"

# ============================================================================
# Machine-Specific Paths
# ============================================================================
# Put Bazel state on a large writable filesystem outside HOME.
# export BAZEL_CACHE_ROOT="/path/to/cache/bazel"

# _add_path "/opt/custom-tool/bin"
# _add_path "/opt/homebrew/bin"  # macOS

# ============================================================================
# Hardware-Specific Settings
# ============================================================================
# export ROCM_GPU_TARGET=gfx1100  # RDNA3
EOF
}

# Ensure ~/.shrc.local exists (create template if missing).
_ensure_shrc_local_locked() {
    local destination="$HOME/.shrc.local"

    if [ -L "$destination" ]; then
        error "Refusing symlinked local configuration: $destination"
        return 1
    fi
    if [ -e "$destination" ]; then
        if [ ! -f "$destination" ]; then
            error "Local configuration is not a regular file: $destination"
            return 1
        fi
        return 0
    fi

    info "Creating ~/.shrc.local template..."
    _create_local_file_locked \
        "$destination" 644 _render_shrc_local_template
}

_ensure_shrc_local() {
    _with_home_transaction_lock _ensure_shrc_local_locked
}

# Check if identity needs to be configured.
_needs_identity() {
    if [ ! -f "$HOME/.shrc.local" ]; then
        return 0  # Needs setup.
    fi
    # Check for placeholder values.
    grep -q 'USER_NAME="Your Name"' "$HOME/.shrc.local" 2>/dev/null
}

# Check if running interactively.
_is_interactive() {
    [ -t 0 ]  # stdin is a terminal.
}

# Prompt for user identity.
_render_shrc_local_identity() {
    local output_path="$1"
    local name="$2"
    local email="$3"
    local github_id="$4"

    python3 -c '
import pathlib
import re
import sys

path = pathlib.Path(sys.argv[1])
values = {
    "USER_NAME": ("Your Name", sys.argv[2]),
    "USER_EMAIL": ("you@example.com", sys.argv[3]),
    "USER_GITHUB_ID": ("yourusername", sys.argv[4]),
}
text = path.read_text(encoding="utf-8")

def shell_quote(value):
    quote = chr(39)
    replacement = quote + chr(34) + quote + chr(34) + quote
    return quote + value.replace(quote, replacement) + quote

for variable, (placeholder, value) in values.items():
    pattern = re.compile(
        r"^export " + re.escape(variable) + r"=" +
        re.escape("\"" + placeholder + "\"") + r"$",
        re.MULTILINE,
    )
    if len(pattern.findall(text)) != 1:
        raise SystemExit(
            f"expected exactly one placeholder declaration for {variable}"
        )
    text = pattern.sub(
        "export " + variable + "=" + shell_quote(value),
        text,
        count=1,
    )

path.write_text(text, encoding="utf-8")
' "$output_path" "$name" "$email" "$github_id"
}

_update_shrc_local_identity_locked() {
    local name="$1"
    local email="$2"
    local github_id="$3"

    _replace_local_file_locked \
        "$HOME/.shrc.local" _render_shrc_local_identity \
        "$name" "$email" "$github_id"
}

_prompt_identity() {
    info "Setting up user identity..."
    echo ""
    echo "This information is used for git commits and is stored locally."
    echo ""

    local name email github_id

    read -rp "Full name (for git commits): " name
    read -rp "Email address: " email
    read -rp "GitHub username: " github_id

    # Validate required fields.
    if [ -z "$name" ] || [ -z "$email" ]; then
        warn "Name and email are required."
        warn "Edit ~/.shrc.local manually to set your identity."
        return
    fi

    if ! _with_home_transaction_lock \
            _update_shrc_local_identity_locked \
            "$name" "$email" "${github_id:-${USER:-}}"; then
        error "Could not update ~/.shrc.local with user identity"
        return 1
    fi

    info "Updated ~/.shrc.local with your identity"
    echo ""
}

# ============================================================================
# Deps Command
# ============================================================================
cmd_deps() {
    info "Running install-deps.sh..."
    "$DOTFILES/install-deps.sh"
}

# ============================================================================
# Multiplexer Command
# ============================================================================
cmd_multiplexer() {
    "$DOTFILES/bin/update-multiplexer" "$@"
}

# ============================================================================
# Setup Command
# ============================================================================
cmd_setup() {
    info "Configuring git SSH signing..."
    "$DOTFILES/bin/git-setup-signing"
}

# ============================================================================
# Doctor Command
# ============================================================================
cmd_doctor() {
    # Source package definitions.
    source "$DOTFILES/lib/packages.sh"

    echo ""
    printf "%b=== Dotfiles Health Check ===%b\n" "$BOLD" "$NC"
    echo ""

    local all_ok=true
    local configured_bazel_cache_root=""

    # Check packages using shared verification.
    if ! _pkg_verify_all "$GREEN" "$YELLOW" "$RED" "$NC" "$BOLD"; then
        all_ok=false
    fi
    echo ""

    # Check symlinks.
    printf "%bSymlinks:%b\n" "$BOLD" "$NC"
    for link in \
            ~/.zshrc \
            ~/.bashrc \
            ~/.gitconfig \
            ~/.tmux.conf \
            ~/.direnvrc \
            ~/.config/direnv/direnv.toml; do
        if [ -L "$link" ] && [ -e "$link" ]; then
            printf "  %b[OK]%b %s\n" "$GREEN" "$NC" "$link"
        elif [ -L "$link" ]; then
            printf "  %b[BROKEN]%b %s -> %s\n" "$RED" "$NC" "$link" "$(readlink "$link")"
            all_ok=false
        elif [ -e "$link" ]; then
            printf "  %b[FILE]%b %s (not a symlink)\n" "$YELLOW" "$NC" "$link"
        else
            printf "  %b[MISSING]%b %s\n" "$YELLOW" "$NC" "$link"
        fi
    done
    echo ""

    # Check machine-specific files.
    printf "%bMachine-specific files:%b\n" "$BOLD" "$NC"
    for localfile in ~/.shrc.local ~/.gitconfig.local ~/.secrets; do
        if [ -f "$localfile" ]; then
            printf "  %b[OK]%b %s\n" "$GREEN" "$NC" "$localfile"
        else
            printf "  %b[MISSING]%b %s (run 'dotfiles install' to create)\n" "$YELLOW" "$NC" "$localfile"
        fi
    done
    echo ""

    # Bazel must never silently fall back to HOME. The machine rc is loaded
    # after workspace configuration and owns default cache placement.
    printf "%bBazel cache placement:%b\n" "$BOLD" "$NC"
    if ! configured_bazel_cache_root=$(bazel_cache_configured_root); then
        printf "  %b[MISSING]%b BAZEL_CACHE_ROOT is not configured in ~/.shrc.local\n" \
            "$RED" "$NC"
        all_ok=false
    elif ! bazel_cache_validate_root "$configured_bazel_cache_root"; then
        printf "  %b[INVALID]%b BAZEL_CACHE_ROOT=%s\n" \
            "$RED" "$NC" "$configured_bazel_cache_root"
        all_ok=false
    else
        local expected_home_bazelrc=""
        local default_output_user_root=""
        local marker_path=""
        local default_root_state_count=0
        expected_home_bazelrc=$(
            bazel_cache_print_home_bazelrc "$configured_bazel_cache_root"
        )
        if [ -f "$HOME/.bazelrc" ] && [ ! -L "$HOME/.bazelrc" ] &&
                [ "$(cat "$HOME/.bazelrc")" = "$expected_home_bazelrc" ]; then
            printf "  %b[OK]%b ~/.bazelrc -> %s\n" \
                "$GREEN" "$NC" "$configured_bazel_cache_root"
        else
            printf "  %b[DRIFT]%b ~/.bazelrc is not the managed machine configuration\n" \
                "$RED" "$NC"
            all_ok=false
        fi

        default_output_user_root=$(
            bazel_cache_default_output_user_root
        )
        marker_path="$default_output_user_root/$BAZEL_CACHE_GUARD_MARKER"
        if [ -d "$default_output_user_root" ] &&
                [ ! -L "$default_output_user_root" ] &&
                [ ! -w "$default_output_user_root" ] &&
                [ -f "$marker_path" ] && [ ! -L "$marker_path" ] &&
                [ "$(cat "$marker_path")" = \
                    "$(bazel_cache_print_guard_marker \
                        "$configured_bazel_cache_root")" ]; then
            printf "  %b[OK]%b protected default root %s\n" \
                "$GREEN" "$NC" "$default_output_user_root"
        else
            printf "  %b[DRIFT]%b default root is not protected: %s\n" \
                "$RED" "$NC" "$default_output_user_root"
            all_ok=false
        fi

        default_root_state_count=$(
            bazel_cache_default_root_state_count "$default_output_user_root"
        )
        if [ "$default_root_state_count" -eq 0 ]; then
            printf "  %b[OK]%b no Bazel state remains under the default root\n" \
                "$GREEN" "$NC"
        else
            printf "  %b[DRIFT]%b %d unexpected entries remain under the default root\n" \
                "$RED" "$NC" "$default_root_state_count"
            all_ok=false
        fi
    fi
    echo ""

    # Agent clients need regular, current copies because neither client
    # reliably follows the old provider-specific symlink layout.
    printf "%bAgent working contracts:%b\n" "$BOLD" "$NC"
    local managed_contract
    for managed_contract in \
            "$HOME/.claude/CLAUDE.md" \
            "$HOME/.codex/AGENTS.md"; do
        if [ -L "$managed_contract" ]; then
            printf "  %b[DRIFT]%b %s is a symlink; run 'dotfiles install'\n" \
                "$RED" "$NC" "$managed_contract"
            all_ok=false
        elif [ ! -f "$managed_contract" ]; then
            printf "  %b[MISSING]%b %s; run 'dotfiles install'\n" \
                "$RED" "$NC" "$managed_contract"
            all_ok=false
        elif cmp -s \
                "$DOTFILES/agents/WORKING_CONTRACT.md" \
                "$managed_contract"; then
            printf "  %b[OK]%b %s\n" "$GREEN" "$NC" "$managed_contract"
        else
            printf "  %b[DRIFT]%b %s differs from the canonical contract\n" \
                "$RED" "$NC" "$managed_contract"
            all_ok=false
        fi
    done
    echo ""

    # Check for broken symlinks.
    printf "%bBroken symlinks:%b\n" "$BOLD" "$NC"
    local broken_count=0
    for link in \
            ~/.zshrc \
            ~/.bashrc \
            ~/.gitconfig \
            ~/.tmux.conf \
            ~/.direnvrc \
            ~/.config/direnv/direnv.toml \
            ~/.shrc \
            ~/.aliases \
            ~/.profile \
            ~/.p10k.zsh \
            ~/.gitignore_global; do
        if [ -L "$link" ] && [ ! -e "$link" ]; then
            printf "  %b[BROKEN]%b %s -> %s\n" "$RED" "$NC" "$link" "$(readlink "$link")"
            ((++broken_count))
            all_ok=false
        fi
    done
    if [ $broken_count -eq 0 ]; then
        printf "  %b[OK]%b No broken symlinks\n" "$GREEN" "$NC"
    fi
    echo ""

    # Check ~/tools/ setup.
    printf "%bVersioned tools (~/tools/):%b\n" "$BOLD" "$NC"
    if [ -d "$HOME/tools" ]; then
        local found_tools=false
        for tool in llvm cmake ninja bazel cuda rocm vulkan hf; do
            if [ -L "$HOME/tools/$tool/latest" ]; then
                local version
                version=$(basename "$(readlink "$HOME/tools/$tool/latest")")
                printf "  %b[OK]%b %s: %s\n" "$GREEN" "$NC" "$tool" "$version"
                found_tools=true
            fi
        done
        if ! $found_tools; then
            printf "  %b[INFO]%b No versioned tools installed yet\n" "$YELLOW" "$NC"
        fi
    else
        printf "  %b[INFO]%b ~/tools/ not set up (optional)\n" "$YELLOW" "$NC"
    fi
    echo ""

    # Check for uncommitted shell config changes (installer pollution).
    printf "%bShell config status:%b\n" "$BOLD" "$NC"
    local shell_files=(shell/zshrc shell/bashrc shell/profile shell/shrc)
    local dirty_files=()
    for f in "${shell_files[@]}"; do
        if [ -f "$DOTFILES/$f" ] && ! git -C "$DOTFILES" diff --quiet -- "$f" 2>/dev/null; then
            dirty_files+=("$f")
        fi
    done
    if [ ${#dirty_files[@]} -gt 0 ]; then
        printf "  %b[WARN]%b Uncommitted changes detected:\n" "$YELLOW" "$NC"
        for f in "${dirty_files[@]}"; do
            printf "         %s\n" "$f"
        done
        printf "         Run 'dotfiles fixup' to review and integrate\n"
        all_ok=false
    else
        printf "  %b[OK]%b Shell configs are clean\n" "$GREEN" "$NC"
    fi
    echo ""

    # Summary.
    if $all_ok; then
        printf "%bAll required checks passed!%b\n" "$GREEN" "$NC"
    else
        printf "%bSome issues found - see above%b\n" "$RED" "$NC"
        return 1
    fi
}

# ============================================================================
# Fixup Command
# ============================================================================
cmd_fixup() {
    cd "$DOTFILES"

    # Find shell config files with uncommitted changes.
    local shell_files=(shell/zshrc shell/bashrc shell/profile shell/shrc)
    local dirty_files=()
    for f in "${shell_files[@]}"; do
        if [ -f "$f" ] && ! git diff --quiet -- "$f" 2>/dev/null; then
            dirty_files+=("$f")
        fi
    done

    if [ ${#dirty_files[@]} -eq 0 ]; then
        info "Shell configs are clean - nothing to fix"
        return 0
    fi

    echo ""
    printf "%bUncommitted shell config changes detected%b\n" "$BOLD" "$NC"
    echo ""
    warn "Installers often append to ~/.bashrc or ~/.zshrc."
    warn "Since these are symlinks to dotfiles, changes show as git diffs."
    echo ""

    for f in "${dirty_files[@]}"; do
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        printf "%bFile: %s%b\n" "$BOLD" "$f" "$NC"
        echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
        git diff --color=always -- "$f"
        echo ""

        if ! _is_interactive; then
            warn "Non-interactive mode - showing diff only"
            continue
        fi

        echo "Options:"
        echo "  [m] Move additions to ~/.shrc.local (recommended for machine-specific)"
        echo "  [r] Revert changes (discard installer additions)"
        echo "  [k] Keep changes (leave for manual review)"
        echo "  [s] Skip this file"
        echo ""
        read -rp "Choice [m/r/k/s]: " choice

        case "$choice" in
            m|M)
                _fixup_move_to_shrc_local "$f"
                ;;
            r|R)
                git checkout -- "$f"
                info "Reverted $f"
                ;;
            k|K)
                info "Keeping changes in $f"
                ;;
            s|S|*)
                info "Skipping $f"
                ;;
        esac
        echo ""
    done

    # Show remaining status.
    local remaining=0
    for f in "${shell_files[@]}"; do
        if [ -f "$f" ] && ! git diff --quiet -- "$f" 2>/dev/null; then
            ((++remaining))
        fi
    done
    if [ $remaining -eq 0 ]; then
        info "All shell configs are now clean"
    else
        warn "$remaining file(s) still have uncommitted changes"
    fi
}

_render_shrc_local_append() {
    local output_path="$1"
    local source_file="$2"
    local move_date="$3"
    local additions_path="$4"

    {
        printf '\n'
        printf '%s\n' \
            "# ============================================================================"
        printf '# Added by installer (moved from %s on %s)\n' \
            "$source_file" "$move_date"
        printf '%s\n' \
            "# ============================================================================"
        cat "$additions_path"
    } >> "$output_path"
}

_append_shrc_local_locked() {
    local source_file="$1"
    local move_date="$2"
    local additions_path="$3"

    _replace_local_file_locked \
        "$HOME/.shrc.local" _render_shrc_local_append \
        "$source_file" "$move_date" "$additions_path"
}

# Move one exact byte suffix appended to a tracked shell file into
# ~/.shrc.local. Insertions and replacements are left for manual review.
_fixup_move_to_shrc_local() (
    local file="$1"
    local base_path=""
    local current_generation=""
    local current_snapshot_path=""
    local move_date=""
    local suffix_path=""

    # Invoked indirectly by the EXIT trap below.
    # shellcheck disable=SC2317,SC2329
    cleanup_fixup_snapshots() {
        local exit_status=$?
        local snapshot_path=""
        trap - EXIT
        trap '' HUP INT TERM
        for snapshot_path in \
                "$suffix_path" \
                "$current_snapshot_path" \
                "$base_path"; do
            if [ -n "$snapshot_path" ] &&
                    { [ -e "$snapshot_path" ] || [ -L "$snapshot_path" ]; } &&
                    ! unlink "$snapshot_path"; then
                error "Could not clean shell fixup snapshot: $snapshot_path"
                exit_status=1
            fi
        done
        exit "$exit_status"
    }
    trap cleanup_fixup_snapshots EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM

    if ! base_path=$(mktemp) ||
            ! current_snapshot_path=$(mktemp) ||
            ! suffix_path=$(mktemp); then
        error "Could not reserve tracked shell snapshots: $file"
        return 1
    fi
    if ! git show ":$file" > "$base_path"; then
        error "Could not snapshot indexed shell configuration: $file"
        return 1
    fi
    if ! current_generation=$(_local_file_generation "$file"); then
        error "Tracked shell configuration is not a real regular file: $file"
        return 1
    fi
    if ! python3 - "$base_path" "$file" \
            "$current_snapshot_path" "$suffix_path" << 'PY'
import os
import stat
import sys

base_path, source_path, snapshot_path, suffix_path = sys.argv[1:]
source_stat = os.lstat(source_path)
if not stat.S_ISREG(source_stat.st_mode):
    raise SystemExit(1)

flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
flags |= getattr(os, "O_NOFOLLOW", 0)
descriptor = os.open(source_path, flags)
try:
    opened_stat = os.fstat(descriptor)
    if (opened_stat.st_dev, opened_stat.st_ino) != (
            source_stat.st_dev, source_stat.st_ino):
        raise SystemExit(1)
    chunks = []
    while True:
        chunk = os.read(descriptor, 1024 * 1024)
        if not chunk:
            break
        chunks.append(chunk)
    final_stat = os.fstat(descriptor)
finally:
    os.close(descriptor)

if (
    final_stat.st_dev,
    final_stat.st_ino,
    final_stat.st_mtime_ns,
    final_stat.st_size,
) != (
    opened_stat.st_dev,
    opened_stat.st_ino,
    opened_stat.st_mtime_ns,
    opened_stat.st_size,
):
    raise SystemExit(1)

with open(base_path, "rb") as base_file:
    base = base_file.read()
current = b"".join(chunks)
if len(current) <= len(base) or not current.startswith(base):
    raise SystemExit(1)

suffix = current[len(base):]
if b"\0" in suffix:
    raise SystemExit(1)
if base and not base.endswith(b"\n") and not suffix.startswith(b"\n"):
    raise SystemExit(1)

with open(snapshot_path, "wb") as snapshot_file:
    snapshot_file.write(current)
with open(suffix_path, "wb") as suffix_file:
    suffix_file.write(suffix)
PY
    then
        error "Fixup only moves an exact appended suffix; leaving $file untouched"
        return 1
    fi

    if ! _ensure_shrc_local; then
        return 1
    fi
    if ! move_date=$(date +%Y-%m-%d); then
        error "Could not determine fixup date"
        return 1
    fi
    if ! _with_home_transaction_lock \
            _append_shrc_local_locked \
            "$file" "$move_date" "$suffix_path"; then
        return 1
    fi

    # Refuse the restore if either the index or worktree changed after the
    # suffix snapshot. This detects cooperating edits before Git replaces the
    # worktree path; Git does not provide a filesystem CAS against a writer
    # that ignores this operation.
    if ! git show ":$file" | cmp -s - "$base_path" ||
            [ "$(_local_file_generation "$file" 2>/dev/null || true)" != \
                "$current_generation" ] ||
            ! cmp -s "$file" "$current_snapshot_path"; then
        error "Tracked shell changes changed during fixup; leaving $file untouched"
        return 1
    fi
    if ! git checkout -- "$file"; then
        error "Could not restore tracked shell configuration: $file"
        return 1
    fi

    info "Moved additions to ~/.shrc.local and reverted $file"
    info "Review ~/.shrc.local to ensure correctness"
)

# ============================================================================
# Update Command
# ============================================================================
cmd_update() {
    cd "$DOTFILES"

    # Check for uncommitted changes.
    if ! git diff --quiet 2>/dev/null || ! git diff --cached --quiet 2>/dev/null; then
        error "Uncommitted changes in $DOTFILES"
        error "Please commit or stash before updating"
        return 1
    fi

    # Check if we're on a branch that tracks a remote.
    local branch=""
    branch=$(git symbolic-ref --short HEAD 2>/dev/null) || branch=""
    if [ -z "$branch" ]; then
        error "Not on a branch - cannot update"
        return 1
    fi

    local upstream=""
    upstream=$(git rev-parse --abbrev-ref "$branch@{upstream}" 2>/dev/null) ||
        upstream=""
    if [ -z "$upstream" ]; then
        warn "Branch '$branch' has no upstream - publishing local configuration only"
    else
        info "Updating dotfiles from $upstream..."
        if ! git pull --ff-only; then
            error "Update failed - merge conflict or non-fast-forward"
            error "Resolve manually with: cd $DOTFILES && git pull"
            return 1
        fi
    fi

    if ! _publish_agent_contracts; then
        error "Repository updated, but agent contracts were not applied"
        error "Repair with: dotfiles install"
        return 1
    fi

    echo ""
    info "Update complete!"
    echo ""
    echo "To apply shell changes, run:"
    echo "  source ~/.zshrc"
}

# ============================================================================
# Main
# ============================================================================
main() {
    # Default to help if no command.
    if [[ $# -eq 0 ]]; then
        show_help
        exit 0
    fi

    local cmd="$1"
    shift

    case "$cmd" in
        test)    cmd_test "$@" ;;
        doctor)  cmd_doctor "$@" ;;
        fixup)   cmd_fixup "$@" ;;
        update)  cmd_update "$@" ;;
        install) cmd_install "$@" ;;
        deps)    cmd_deps "$@" ;;
        multiplexer) cmd_multiplexer "$@" ;;
        setup)   cmd_setup "$@" ;;
        help|--help|-h) show_help ;;
        *)
            error "Unknown command: $cmd"
            echo ""
            show_help
            exit 1
            ;;
    esac
}

main "$@"
