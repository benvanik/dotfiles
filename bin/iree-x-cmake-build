#!/bin/bash
# Build IREE-X in the paired build directory.
#
# Usage: iree-x-cmake-build [targets...] [-- cmake-args...]
#
# Examples:
#   iree-x-cmake-build                           # Build all targets
#   iree-x-cmake-build iree-compile              # Build specific target
#   iree-x-cmake-build iree-opt iree-compile     # Build multiple targets
#   iree-x-cmake-build -- -j16                   # Override parallel jobs
#
# This script automatically finds the correct build directory based on the
# current worktree location:
#   ~/src/iree-x/main/   -> ~/src/iree-x/builds/main/
#   ~/src/iree-x/<name>/ -> ~/src/iree-x/builds/<name>/

set -euo pipefail

# Colors.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}[iree-x-build]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[iree-x-build]${NC} %s\n" "$1"; }
error() { printf "${RED}[iree-x-build]${NC} %s\n" "$1" >&2; }

# Find the IREE-X worktree root (directory with .git and CMakeLists.txt).
find_worktree_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.git" ] && [ -f "$dir/CMakeLists.txt" ]; then
            if grep -q "project(IREE" "$dir/CMakeLists.txt" 2>/dev/null; then
                echo "$dir"
                return 0
            fi
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

# Infer build directory from source directory.
infer_build_directory() {
    local source_dir="$1"
    local iree_x_root="$HOME/src/iree-x"

    # Check if we're in the IREE-X directory structure.
    if [[ "$source_dir" == "$iree_x_root/"* ]]; then
        local relative="${source_dir#"$iree_x_root"/}"
        local worktree_name="${relative%%/*}"
        if [ "$worktree_name" != "builds" ]; then
            echo "$iree_x_root/builds/$worktree_name"
            return 0
        fi
    fi

    # Default.
    echo "$source_dir/build"
}

# Find worktree root.
if ! SOURCE_DIR=$(find_worktree_root); then
    SOURCE_DIR=""
fi
if [ -z "$SOURCE_DIR" ]; then
    error "Not in an IREE-X CMake worktree"
    error "Run from a checkout with .git and top-level CMakeLists.txt under ~/src/iree-x/<worktree>/"
    exit 1
fi

# Determine build directory.
BUILD_DIR=$(infer_build_directory "$SOURCE_DIR")

# Check if build directory exists and is configured.
if [ ! -d "$BUILD_DIR" ]; then
    error "Build directory not found: $BUILD_DIR"
    error "Run iree-x-cmake-configure first"
    exit 1
fi

if [ ! -f "$BUILD_DIR/CMakeCache.txt" ]; then
    error "Build directory not configured: $BUILD_DIR"
    error "Run iree-x-cmake-configure first"
    exit 1
fi

# Parse arguments: everything before -- is a target, after is cmake args.
TARGETS=()
CMAKE_ARGS=()
PARALLEL_JOBS="-j90"
SEEN_SEPARATOR=false

for arg in "$@"; do
    if [ "$arg" = "--" ]; then
        SEEN_SEPARATOR=true
        continue
    fi
    if $SEEN_SEPARATOR; then
        # Check if it's a -j flag and capture it.
        if [[ "$arg" == -j* ]]; then
            PARALLEL_JOBS="$arg"
        else
            CMAKE_ARGS+=("$arg")
        fi
    else
        TARGETS+=("$arg")
    fi
done

# Build command.
CMD=(cmake --build "$BUILD_DIR" "$PARALLEL_JOBS")
for target in "${TARGETS[@]}"; do
    CMD+=(--target "$target")
done
if [ ${#CMAKE_ARGS[@]} -gt 0 ]; then
    CMD+=("${CMAKE_ARGS[@]}")
fi

info "Source: $SOURCE_DIR"
info "Build:  $BUILD_DIR"
if [ ${#TARGETS[@]} -gt 0 ]; then
    info "Targets: ${TARGETS[*]}"
fi
echo ""

# Execute build.
exec "${CMD[@]}"
