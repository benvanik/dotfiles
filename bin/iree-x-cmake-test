#!/bin/bash
# Run IREE-X tests with consistent configuration.
#
# Usage: iree-x-cmake-test [ctest-args...]
#
# Examples:
#   iree-x-cmake-test                           # Run all tests
#   iree-x-cmake-test -R "Dialect"              # Run tests matching regex
#   iree-x-cmake-test -N                        # List tests (dry run)
#   iree-x-cmake-test --output-on-failure       # Show output on failure
#
# This script automatically finds the correct build directory based on the
# current worktree location:
#   ~/src/iree-x/main/   -> ~/src/iree-x/builds/main/
#   ~/src/iree-x/<name>/ -> ~/src/iree-x/builds/<name>/

set -euo pipefail

# Colors.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}[iree-x-test]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[iree-x-test]${NC} %s\n" "$1"; }
error() { printf "${RED}[iree-x-test]${NC} %s\n" "$1" >&2; }

# Find the IREE-X worktree root (directory with .git and CMakeLists.txt).
find_worktree_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -e "$dir/.git" ] && [ -f "$dir/CMakeLists.txt" ]; then
            if grep -q "project(IREE" "$dir/CMakeLists.txt" 2>/dev/null; then
                echo "$dir"
                return 0
            fi
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

# Infer build directory from source directory.
infer_build_directory() {
    local source_dir="$1"
    local iree_x_root="$HOME/src/iree-x"

    # Check if we're in the IREE-X directory structure.
    if [[ "$source_dir" == "$iree_x_root/"* ]]; then
        local relative="${source_dir#"$iree_x_root"/}"
        local worktree_name="${relative%%/*}"
        if [ "$worktree_name" != "builds" ]; then
            echo "$iree_x_root/builds/$worktree_name"
            return 0
        fi
    fi

    # Default.
    echo "$source_dir/build"
}

# Find worktree root.
if ! SOURCE_DIR=$(find_worktree_root); then
    SOURCE_DIR=""
fi
if [ -z "$SOURCE_DIR" ]; then
    error "Not in an IREE-X CMake worktree"
    error "Run from a checkout with .git and top-level CMakeLists.txt under ~/src/iree-x/<worktree>/"
    exit 1
fi

# Determine build directory.
BUILD_DIR=$(infer_build_directory "$SOURCE_DIR")

# Check if build directory exists and is configured.
if [ ! -d "$BUILD_DIR" ]; then
    error "Build directory not found: $BUILD_DIR"
    error "Run iree-x-cmake-configure first"
    exit 1
fi

if [ ! -f "$BUILD_DIR/CMakeCache.txt" ]; then
    error "Build directory not configured: $BUILD_DIR"
    error "Run iree-x-cmake-configure first"
    exit 1
fi

info "Source: $SOURCE_DIR"
info "Build:  $BUILD_DIR"
echo ""

# Run ctest in the build directory.
cd "$BUILD_DIR"
exec ctest "$@"
