#!/bin/bash
# Removes an IREE-X worktree and its associated build directory.
#
# Usage: iree-x-worktree-deinit [--force] <worktree-name>
#
# Examples:
#   iree-x-worktree-deinit feature
#   iree-x-worktree-deinit my-wt
#
# This removes:
#   - Git worktree at ~/src/iree-x/<name>/
#   - Build directory at ~/src/iree-x/builds/<name>/
#   - Associated tmux session (if any)
#   - Non-empty .beads moved to ~/src/iree-x/attic/<name>/.beads

set -euo pipefail

# Colors.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}[iree-x-worktree]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[iree-x-worktree]${NC} %s\n" "$1"; }
error() { printf "${RED}[iree-x-worktree]${NC} %s\n" "$1" >&2; }

show_help() {
    cat << 'EOF'
iree-x-worktree-deinit - Remove an IREE-X worktree

USAGE
    iree-x-worktree-deinit [--force] <name>

OPTIONS
    --force     Remove a dirty worktree. Without this, dirty worktrees fail loud.

ARGUMENTS
    <name>      Worktree name (directory basename under ~/src/iree-x/)

EXAMPLES
    iree-x-worktree-deinit feature1
    iree-x-worktree-deinit mywork

WHAT IT REMOVES
    ~/src/iree-x/<name>/           Git worktree (via git worktree remove)
    ~/src/iree-x/builds/<name>/    Build directory
    ~/src/iree-x/attic/<name>/     Archived .beads, if present and non-empty
    iree-x-<name> tmux session   If running

SEE ALSO
    iree-x-worktree-init    Create new worktree
    iree-x-dev              Create/attach tmux session
EOF
}

# Handle --help early.
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
esac

FORCE=false
INPUT=""
while [ $# -gt 0 ]; do
    case "$1" in
        --force)
            FORCE=true
            shift
            ;;
        -*)
            error "Unknown option: $1"
            show_help
            exit 1
            ;;
        *)
            if [ -n "$INPUT" ]; then
                error "Only one worktree name may be provided"
                exit 1
            fi
            INPUT=$1
            shift
            ;;
    esac
done

if [ -z "$INPUT" ]; then
    show_help
    exit 1
fi

IREE_X_ROOT="$HOME/src/iree-x"
MAIN_WORKTREE="$IREE_X_ROOT/main"

# Determine the worktree name and path.
if [[ "$INPUT" == /* ]]; then
    # Absolute path provided - extract name.
    WORKTREE_PATH="$INPUT"
    WORKTREE_NAME=$(basename "$WORKTREE_PATH")
    case "$WORKTREE_PATH" in
        "$IREE_X_ROOT"/*)
            ;;
        *)
            error "Absolute path is outside ~/src/iree-x: $WORKTREE_PATH"
            exit 1
            ;;
    esac
elif [[ "$INPUT" == */* ]]; then
    # Relative path - error.
    error "Please provide just the worktree name, not a path"
    error "Example: iree-x-worktree-deinit feature"
    exit 1
else
    # Name provided.
    WORKTREE_NAME="$INPUT"
    WORKTREE_PATH="$IREE_X_ROOT/$WORKTREE_NAME"
fi

BUILD_PATH="$IREE_X_ROOT/builds/$WORKTREE_NAME"

# Verify the worktree exists.
if [ ! -d "$WORKTREE_PATH" ]; then
    error "Worktree not found at $WORKTREE_PATH"
    exit 1
fi

# Prevent removing reserved project directories.
case "$WORKTREE_NAME" in
    main|builds)
        error "Cannot remove '$WORKTREE_NAME' - reserved for project infrastructure"
        exit 1
        ;;
esac

# Verify it's actually a git worktree (not a regular directory).
if [ ! -f "$WORKTREE_PATH/.git" ]; then
    error "$WORKTREE_PATH does not appear to be a git worktree"
    exit 1
fi

echo "Removing worktree: $WORKTREE_NAME"
echo "  Location: $WORKTREE_PATH"
echo "  Build dir: $BUILD_PATH"
echo ""

# Preserve source changes unless the caller explicitly forces removal.
if ! $FORCE; then
    DIRTY_STATUS=$(git -C "$WORKTREE_PATH" status --short)
    if [ -n "$DIRTY_STATUS" ]; then
        error "Worktree has local changes; refusing to remove without --force"
        echo "$DIRTY_STATUS" >&2
        exit 1
    fi
fi

# Archive ignored local state and kill the associated tmux session.
project-deinit --session "iree-x-$WORKTREE_NAME" --yes "$WORKTREE_PATH"

# Remove the worktree using git.
cd "$MAIN_WORKTREE"
if $FORCE; then
    git worktree remove "$WORKTREE_PATH" --force
else
    git worktree remove "$WORKTREE_PATH"
fi

# Remove the build directory if it exists.
if [ -d "$BUILD_PATH" ]; then
    info "Removing build directory: $BUILD_PATH"
    rm -rf "$BUILD_PATH"
else
    warn "Build directory not found (skipping): $BUILD_PATH"
fi

# Prune any stale worktree references.
git worktree prune

echo ""
info "Worktree removed successfully!"
