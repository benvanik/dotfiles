#!/bin/bash
# Creates an IREE-X worktree with shared configuration.
#
# Usage: iree-x-worktree-init <branch-name> [worktree-name]
#
# Examples:
#   iree-x-worktree-init users/me/feature        # Creates ~/src/iree-x/feature/
#   iree-x-worktree-init users/me/feature feat   # Creates ~/src/iree-x/feat/
#
# Creates:
#   - Git worktree at ~/src/iree-x/<name>/
#   - Build directory at ~/src/iree-x/builds/<name>/
#   - Symlinks for .vscode/ and AGENTS.override.md from main/
#   - Per-project shell history via .envrc
#   - VSCode workspace file with deterministic color scheme

set -euo pipefail

# Colors.
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}[iree-x-worktree]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[iree-x-worktree]${NC} %s\n" "$1"; }
error() { printf "${RED}[iree-x-worktree]${NC} %s\n" "$1" >&2; }

show_help() {
    cat << 'EOF'
iree-x-worktree-init - Create an IREE-X development worktree

USAGE
    iree-x-worktree-init <branch> [name]

ARGUMENTS
    <branch>    Git branch name (e.g., main, users/you/feature)
                Created from main if it doesn't exist
    [name]      Optional worktree name (default: basename of branch)

EXAMPLES
    iree-x-worktree-init users/me/feature
        Creates ~/src/iree-x/feature/ with tmux session iree-x-feature

    iree-x-worktree-init users/me/feature mywork
        Creates ~/src/iree-x/mywork/ with tmux session iree-x-mywork

WHAT IT CREATES
    ~/src/iree-x/<name>/           Git worktree
    ~/src/iree-x/builds/<name>/    Build directory
    Symlinks: .vscode/ and AGENTS.override.md from main/
    .envrc with direnv integration
    iree-x-<name>.code-workspace with color-coded theme

WORKFLOW
    1. Create worktree:
         iree-x-worktree-init users/you/feature

    2. Start tmux session:
         cd ~/src/iree-x/feature
         iree-x-dev feature

    3. Configure and build:
         iree-x-cmake-configure
         iree-x-cmake-build

    4. When done:
         iree-x-worktree-deinit feature

SEE ALSO
    iree-x-worktree-deinit    Remove worktree and build directory
    iree-x-dev                Create/attach tmux session
    iree-x-cmake-configure    Configure cmake build
    iree-x-cmake-build        Build with standard flags
EOF
}

# Handle --help early.
case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
esac

if [ $# -lt 1 ]; then
    show_help
    exit 1
fi

BRANCH=$1
IREE_X_ROOT="$HOME/src/iree-x"
MAIN_WORKTREE="$IREE_X_ROOT/main"

# Verify main worktree exists.
if [ ! -e "$MAIN_WORKTREE/.git" ]; then
    error "Main IREE-X worktree not found at $MAIN_WORKTREE"
    error "Please set up the main worktree first."
    exit 1
fi

# Default worktree name: sanitize branch name.
if [ $# -lt 2 ]; then
    # Convert users/me/feature -> feature.
    WORKTREE_NAME=$(basename "$BRANCH")
else
    WORKTREE_NAME=$2
fi

# Prevent overwriting reserved project directories.
case "$WORKTREE_NAME" in
    ""|.|..|-*|*/*)
        error "Invalid worktree name: $WORKTREE_NAME"
        error "Please provide a single directory name under ~/src/iree-x."
        exit 1
        ;;
    main|builds)
        error "Cannot create worktree named '$WORKTREE_NAME' - reserved for project infrastructure"
        exit 1
        ;;
esac

WORKTREE_PATH="$IREE_X_ROOT/$WORKTREE_NAME"
BUILD_PATH="$IREE_X_ROOT/builds/$WORKTREE_NAME"

# Check if worktree already exists.
if [ -d "$WORKTREE_PATH" ]; then
    error "Worktree already exists at $WORKTREE_PATH"
    exit 1
fi

info "Creating worktree..."
echo "  Branch: $BRANCH"
echo "  Location: $WORKTREE_PATH"
echo "  Build dir: $BUILD_PATH"
echo ""

# Create the worktree.
cd "$MAIN_WORKTREE"

# Check if branch exists locally, remotely, or needs to be created.
if git show-ref --verify --quiet "refs/heads/$BRANCH"; then
    # Branch exists locally.
    git worktree add "$WORKTREE_PATH" "$BRANCH"
elif git show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    # Branch exists on remote - track it.
    git worktree add --track -b "$BRANCH" "$WORKTREE_PATH" "origin/$BRANCH"
else
    # Branch doesn't exist - create new branch from main.
    info "Branch '$BRANCH' doesn't exist, creating from main..."
    git worktree add -b "$BRANCH" "$WORKTREE_PATH" main
fi

# Symlink shared editor and agent configuration.
cd "$WORKTREE_PATH"
if [ -e .vscode ] || [ -L .vscode ]; then
    rm -rf .vscode
fi
if [ -d "$MAIN_WORKTREE/.vscode" ]; then
    ln -s ../main/.vscode .vscode
    info "Symlinked: .vscode -> ../main/.vscode"
else
    warn "Main worktree has no .vscode directory; skipping .vscode symlink"
fi

if [ -e AGENTS.override.md ] || [ -L AGENTS.override.md ]; then
    rm -f AGENTS.override.md
fi
if [ -f "$MAIN_WORKTREE/AGENTS.override.md" ]; then
    ln -s ../main/AGENTS.override.md AGENTS.override.md
    info "Symlinked: AGENTS.override.md -> ../main/AGENTS.override.md"
else
    warn "Main worktree has no AGENTS.override.md; skipping agent guide symlink"
fi

# Initialize submodules using main worktree as reference (shares objects via alternates).
info "Initializing submodules (using main worktree as reference)..."
git submodule update --init --reference "$MAIN_WORKTREE"

# Create build directory.
mkdir -p "$BUILD_PATH"
info "Created build directory: $BUILD_PATH"

# Set up per-project shell history via direnv.
info "Setting up project environment..."
cat > .envrc << 'EOF'
# IREE-X worktree environment.
# Edit tool versions as needed. Run `direnv allow` after changes.

# Per-project shell history (shared across ~/src/iree-x/).
use_project_history "$HOME/src/iree-x/.history"

# Build tools.
use_venv
use_cmake ">=3.28.0"
use_ninja
use_llvm ">=21.0.0"
use_bazel

# Repository-local build scripts.
PATH_add build_tools/bin

# Compiler cache (shared across all IREE-X worktrees).
use_ccache "iree-x"

# GPU/runtime tools.
use_rocm ">=6.0.0"  # Linux only.
use_vulkan

# Machine-specific overrides.
source_local_envrc
EOF

# Create .envrc.local for machine-specific overrides.
cat > .envrc.local << 'EOF'
# Machine-specific overrides (not committed to git).

# Override LLVM version:
# use_llvm "20.1.0"

# Override ROCm for this worktree:
# use_rocm "debug"
EOF

# Create history directory at project root.
mkdir -p "$IREE_X_ROOT/.history"

# Allow direnv for this worktree.
if command -v direnv &>/dev/null; then
    direnv allow
fi

# Generate VS Code workspace using project-init.
project-init --no-env \
    --cmake "$BUILD_PATH" \
    --llvm \
    --bazel \
    --vscode-name "iree-x-$WORKTREE_NAME" \
    --vscode-settings "$HOME/.dotfiles/projects/iree-x/vscode-settings.json"

echo ""
info "Worktree created successfully!"
echo ""
echo "Next steps:"
echo "  cd $WORKTREE_PATH"
echo "  iree-x-dev $WORKTREE_NAME"
echo ""
echo "Build workflow:"
echo "  iree-x-cmake-configure    # Configure CMake build"
echo "  iree-x-cmake-build        # Build with ninja"
echo "  iree-x-cmake-test         # Run tests"
echo ""
echo "Open in VSCode:"
echo "  iree-x-code $WORKTREE_NAME"
