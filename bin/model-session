#!/usr/bin/env python3
"""Dotfiles entry point for external model-profile sessions."""

from __future__ import annotations

import pathlib
import sys


DOTFILES_ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(DOTFILES_ROOT / "lib"))

from model_session.launcher import main  # noqa: E402


raise SystemExit(main(argument_zero=sys.argv[0]))
