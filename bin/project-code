#!/bin/bash
# Launch VS Code with shell environment and workspace auto-detection.
# Usage: project-code [directory] [-- code-args...]
#
# Sources ~/.shrc for GUI launches, auto-detects workspace files.

# Source environment for GUI launches (before set -e, shrc has non-zero exits).
[ -f "$HOME/.shrc" ] && . "$HOME/.shrc"

set -e

# Parse arguments.
TARGET_DIR="."
TARGET_DIR_SET=false
CODE_ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --help|-h)
            echo "Usage: project-code [directory] [-- code-args...]"
            echo ""
            echo "Launch VS Code with shell environment and workspace detection."
            echo "Looks for .code-workspace or *.code-workspace in directory."
            exit 0
            ;;
        --)
            shift
            CODE_ARGS=("$@")
            break
            ;;
        -*)
            printf 'project-code: unknown option before --: %s\n' "$1" >&2
            exit 1
            ;;
        *)
            if [ "$TARGET_DIR_SET" = "true" ]; then
                printf 'project-code: unexpected extra directory: %s\n' "$1" >&2
                exit 1
            fi
            TARGET_DIR="$1"
            TARGET_DIR_SET=true
            ;;
    esac
    shift
done

if [ ! -d "$TARGET_DIR" ]; then
    printf 'project-code: directory does not exist: %s\n' "$TARGET_DIR" >&2
    exit 1
fi

# Find workspace file.
find_workspace() {
    local dir="$1"
    local directory
    directory=$(CDPATH='' cd -- "$dir" 2>/dev/null && pwd -P) || return 1
    local directory_name
    directory_name=$(basename "$directory")

    # Try <directory>.code-workspace first, then any workspace file.
    if [ -f "$directory/$directory_name.code-workspace" ]; then
        echo "$directory/$directory_name.code-workspace"
    else
        local workspace
        for workspace in "$directory"/*.code-workspace; do
            [ -f "$workspace" ] || continue
            echo "$workspace"
            break
        done
    fi
}

WORKSPACE=$(find_workspace "$TARGET_DIR") || {
    printf 'project-code: could not resolve directory: %s\n' "$TARGET_DIR" >&2
    exit 1
}

if [ -n "$WORKSPACE" ]; then
    exec code "$WORKSPACE" "${CODE_ARGS[@]}"
else
    exec code "$TARGET_DIR" "${CODE_ARGS[@]}"
fi
