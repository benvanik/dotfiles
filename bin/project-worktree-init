#!/bin/bash
# Create a sibling Git worktree using the <project>/main layout.

set -euo pipefail

SCRIPT_DIR=$(CDPATH='' cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=../lib/project-worktrees.sh
. "$SCRIPT_DIR/../lib/project-worktrees.sh"

GREEN='\033[0;32m'
RED='\033[0;31m'
NC='\033[0m'

info() { printf "${GREEN}[project-worktree]${NC} %s\n" "$1"; }
error() { printf "${RED}[project-worktree]${NC} %s\n" "$1" >&2; }

show_help() {
    cat << 'EOF'
project-worktree-init - Create a sibling Git worktree

USAGE
    project-worktree-init <branch> [name]

ARGUMENTS
    branch    Local or origin branch to check out. A missing branch is
              created from main.
    name      Sibling directory name (default: basename of branch)

LAYOUT
    The repository's primary Git worktree must be <project>/main. Its
    checked-out branch may vary; new branches start from main by default.
    New worktrees are created at <project>/<name>.

    If main/AGENTS.override.md, main/.bazelrc.cache, main/.bazelrc.local, or
    main/.beads exists, the new worktree receives a relative symlink to that
    shared local state. The main worktree must own .beads as a physical
    directory.

    A tracked .envrc is inherited with the branch. The command prints the
    explicit direnv authorization needed before entering the new worktree.

EXAMPLES
    project-worktree-init users/me/feature
    project-worktree-init users/me/feature experiment
EOF
}

case "${1:-}" in
    -h|--help)
        show_help
        exit 0
        ;;
esac

if [ $# -lt 1 ] || [ $# -gt 2 ]; then
    show_help >&2
    exit 1
fi

BRANCH="$1"
WORKTREE_NAME="${2:-$(basename "$BRANCH")}"

if ! git check-ref-format --branch "$BRANCH" >/dev/null 2>&1; then
    error "Invalid branch name: $BRANCH"
    exit 1
fi

if [[ ! "$WORKTREE_NAME" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || \
        [ "$WORKTREE_NAME" = "." ] || [ "$WORKTREE_NAME" = ".." ]; then
    error "Invalid worktree name: $WORKTREE_NAME"
    error "Use letters, numbers, periods, underscores, and hyphens."
    exit 1
fi

case "$WORKTREE_NAME" in
    main)
        error "The worktree name 'main' is reserved for the primary checkout."
        exit 1
        ;;
    attic)
        error "The worktree name 'attic' is reserved for archived project state."
        exit 1
        ;;
esac

if ! CURRENT_WORKTREE=$(git rev-parse --show-toplevel 2>/dev/null); then
    error "Run this command from inside an existing Git worktree."
    exit 1
fi

if ! MAIN_WORKTREE=$(project_main_worktree "$CURRENT_WORKTREE"); then
    error "No primary worktree named 'main' is registered for this repository."
    exit 1
fi

if [ "$(basename "$MAIN_WORKTREE")" != "main" ]; then
    error "The main worktree must be named 'main': $MAIN_WORKTREE"
    exit 1
fi

PROJECT_ROOT=$(dirname "$MAIN_WORKTREE")
WORKTREE_PATH="$PROJECT_ROOT/$WORKTREE_NAME"

if [ -e "$WORKTREE_PATH" ] || [ -L "$WORKTREE_PATH" ]; then
    error "Destination already exists: $WORKTREE_PATH"
    exit 1
fi

START_POINT="main"
BRANCH_MODE="new"
if git -C "$MAIN_WORKTREE" show-ref --verify --quiet "refs/heads/$BRANCH"; then
    START_POINT="$BRANCH"
    BRANCH_MODE="local"
elif git -C "$MAIN_WORKTREE" show-ref --verify --quiet "refs/remotes/origin/$BRANCH"; then
    START_POINT="origin/$BRANCH"
    BRANCH_MODE="remote"
fi

SHARED_PATHS=()
while IFS=$'\t' read -r shared_kind shared_path; do
    shared_source="$MAIN_WORKTREE/$shared_path"
    case "$shared_kind" in
        file)
            if [ -L "$shared_source" ] && [ ! -e "$shared_source" ]; then
                error "The main worktree has a broken $shared_path symlink."
                exit 1
            fi
            if [ -e "$shared_source" ] && [ ! -f "$shared_source" ]; then
                error "The main worktree's $shared_path is not a regular file."
                exit 1
            fi
            ;;
        directory)
            if [ -L "$shared_source" ]; then
                error "The main worktree's $shared_path must be a physical directory, not a symlink."
                exit 1
            fi
            if [ -e "$shared_source" ] && [ ! -d "$shared_source" ]; then
                error "The main worktree's $shared_path is not a directory."
                exit 1
            fi
            ;;
        *)
            error "Unknown shared worktree entry kind: $shared_kind"
            exit 1
            ;;
    esac
    if [ -e "$shared_source" ] && git -C "$MAIN_WORKTREE" cat-file -e \
            "$START_POINT:$shared_path" 2>/dev/null; then
        error "$shared_path is tracked on $START_POINT and cannot be replaced by a shared symlink."
        exit 1
    fi
    if [ -e "$shared_source" ]; then
        SHARED_PATHS+=("$shared_path")
    fi
done < <(project_worktree_shared_entries)

CREATED_BRANCH_OID=""
if [ "$BRANCH_MODE" != "local" ]; then
    CREATED_BRANCH_OID=$(
        git -C "$MAIN_WORKTREE" rev-parse "$START_POINT^{commit}"
    )
fi

info "Creating $WORKTREE_PATH from $START_POINT"
case "$BRANCH_MODE" in
    local)
        git -C "$MAIN_WORKTREE" worktree add "$WORKTREE_PATH" "$BRANCH"
        ;;
    remote)
        git -C "$MAIN_WORKTREE" worktree add --track -b "$BRANCH" \
            "$WORKTREE_PATH" "$START_POINT"
        ;;
    new)
        git -C "$MAIN_WORKTREE" worktree add -b "$BRANCH" \
            "$WORKTREE_PATH" "$START_POINT"
        ;;
esac

LINKED_SHARED_PATHS=()
for shared_path in "${SHARED_PATHS[@]}"; do
    shared_target="../main/$shared_path"
    if ! ln -s "$shared_target" "$WORKTREE_PATH/$shared_path"; then
        error "Could not link the shared $shared_path; rolling back the new worktree."
        for linked_path in "${LINKED_SHARED_PATHS[@]}"; do
            if ! unlink "$WORKTREE_PATH/$linked_path"; then
                error "Could not remove the managed $linked_path link during rollback."
                error "The new worktree was preserved for manual recovery: $WORKTREE_PATH"
                exit 1
            fi
        done
        if ! git -C "$MAIN_WORKTREE" worktree remove "$WORKTREE_PATH"; then
            error "Rollback refused to remove the new worktree because its contents changed:"
            error "$WORKTREE_PATH"
            exit 1
        fi
        if [ -n "$CREATED_BRANCH_OID" ] &&
                ! git -C "$MAIN_WORKTREE" update-ref -d \
                    "refs/heads/$BRANCH" "$CREATED_BRANCH_OID"; then
            error "The worktree was removed, but its newly created branch remains: $BRANCH"
            exit 1
        fi
        error "New worktree and branch were rolled back."
        exit 1
    fi
    LINKED_SHARED_PATHS+=("$shared_path")
    info "Linked $shared_path -> $shared_target"
done

info "Created worktree: $WORKTREE_PATH"
if [ -f "$WORKTREE_PATH/.envrc" ]; then
    printf '  direnv allow %q\n' "$WORKTREE_PATH"
fi
printf '  cd %q\n' "$WORKTREE_PATH"
