#!/usr/bin/env python3
"""Dotfiles entry point for the local Runpod control plane."""

from __future__ import annotations

import pathlib
import sys


DOTFILES_ROOT = pathlib.Path(__file__).resolve().parents[1]
sys.path.insert(0, str(DOTFILES_ROOT / "lib"))

from runpod_local.cli import main  # noqa: E402


raise SystemExit(main())
