#!/bin/bash
# Install official tmux and Byobu releases, then update TPM and its plugins.
set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
INSTALL_PREFIX="${MULTIPLEXER_INSTALL_PREFIX:-$HOME/.local}"
PLUGIN_ROOT="${TMUX_PLUGIN_MANAGER_PATH:-$HOME/.tmux/plugins}"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
NC='\033[0m'

info() { printf "${GREEN}[multiplexer]${NC} %s\n" "$1"; }
warn() { printf "${YELLOW}[multiplexer]${NC} %s\n" "$1"; }
error() { printf "${RED}[multiplexer]${NC} %s\n" "$1" >&2; }

FORCE=false
ENABLE_TRUSTMUX=false
TMUX_VERSION=""
BYOBU_VERSION=""

show_help() {
    cat << 'EOF'
update-multiplexer - Install the current official terminal multiplexer stack

USAGE
    update-multiplexer [options]

OPTIONS
    --tmux-version VERSION    Install a specific official tmux release
    --byobu-version VERSION   Install a specific official Byobu release
    --enable-trustmux         Include Byobu's mobile companion daemon
    --force                   Rebuild even when both versions are current
    -h, --help                Show this help

The default installation contains the latest non-prerelease tmux and Byobu
releases under ~/.local. Ubuntu packages remain available under /usr/bin as
fallbacks. Trustmux is excluded unless explicitly enabled.

The updater refuses to replace tmux while this user has a server running.
Detach, save any needed state, and stop the server before upgrading.
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --tmux-version)
            [[ $# -ge 2 ]] || { error "--tmux-version requires a value"; exit 1; }
            TMUX_VERSION="$2"
            shift 2
            ;;
        --byobu-version)
            [[ $# -ge 2 ]] || { error "--byobu-version requires a value"; exit 1; }
            BYOBU_VERSION="$2"
            shift 2
            ;;
        --enable-trustmux)
            ENABLE_TRUSTMUX=true
            shift
            ;;
        --force)
            FORCE=true
            shift
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        *)
            error "Unknown option: $1"
            exit 1
            ;;
    esac
done

if [[ "$(uname -s)" != "Linux" ]]; then
    error "Source installation is currently supported on Linux only"
    exit 1
fi

required_commands=(
    autoconf automake bison cc curl git jq make nproc pkg-config sha256sum stat tar
)
for required_command in "${required_commands[@]}"; do
    if ! command -v "$required_command" >/dev/null 2>&1; then
        error "Missing build dependency: $required_command"
        exit 1
    fi
done

for required_module in libevent ncurses; do
    if ! pkg-config --exists "$required_module"; then
        error "Missing pkg-config module: $required_module"
        exit 1
    fi
done

if [[ ! -f "$DOTFILES/tmux.conf" ]]; then
    error "tmux configuration not found: $DOTFILES/tmux.conf"
    exit 1
fi

validate_version() {
    local component="$1"
    local version="$2"
    if [[ -z "$version" || "$version" == *[!A-Za-z0-9._-]* ]]; then
        error "Invalid $component version: $version"
        exit 1
    fi
}

running_tmux_servers() {
    local user_id
    user_id=$(id -u)

    local comm_file process_directory process_name process_user_id
    for comm_file in /proc/[0-9]*/comm; do
        [[ -r "$comm_file" ]] || continue
        process_directory="${comm_file%/comm}"
        process_user_id=$(stat --format='%u' "$process_directory" 2>/dev/null) || continue
        [[ "$process_user_id" == "$user_id" ]] || continue
        IFS= read -r process_name < "$comm_file" || continue
        if [[ "$process_name" == "tmux: server" ]]; then
            printf '%s\n' "${process_directory##*/}"
        fi
    done
}

github_release() {
    local repository="$1"
    local version="$2"
    local endpoint
    if [[ -n "$version" ]]; then
        endpoint="https://api.github.com/repos/$repository/releases/tags/$version"
    else
        endpoint="https://api.github.com/repos/$repository/releases/latest"
    fi
    curl --fail --silent --show-error --location \
        --header 'Accept: application/vnd.github+json' \
        --header 'X-GitHub-Api-Version: 2022-11-28' \
        "$endpoint"
}

info "Resolving official releases..."
tmux_release=$(github_release tmux/tmux "$TMUX_VERSION")
if [[ -z "$TMUX_VERSION" ]]; then
    TMUX_VERSION=$(jq --exit-status --raw-output '.tag_name' <<< "$tmux_release")
fi
validate_version tmux "$TMUX_VERSION"

tmux_asset_name="tmux-$TMUX_VERSION.tar.gz"
tmux_asset_url=$(jq --exit-status --raw-output \
    --arg name "$tmux_asset_name" \
    '.assets[] | select(.name == $name) | .browser_download_url' \
    <<< "$tmux_release")
tmux_asset_digest=$(jq --exit-status --raw-output \
    --arg name "$tmux_asset_name" \
    '.assets[] | select(.name == $name) | .digest' \
    <<< "$tmux_release")
if [[ "$tmux_asset_digest" != sha256:* ]]; then
    error "Official tmux asset has no SHA-256 digest: $tmux_asset_name"
    exit 1
fi
tmux_asset_sha256="${tmux_asset_digest#sha256:}"

byobu_release=$(github_release dustinkirkland/byobu "$BYOBU_VERSION")
if [[ -z "$BYOBU_VERSION" ]]; then
    BYOBU_VERSION=$(jq --exit-status --raw-output '.tag_name' <<< "$byobu_release")
fi
validate_version Byobu "$BYOBU_VERSION"

info "Target stack: tmux $TMUX_VERSION, Byobu $BYOBU_VERSION"

installed_tmux_version=""
if [[ -x "$INSTALL_PREFIX/bin/tmux" ]]; then
    installed_tmux_version=$("$INSTALL_PREFIX/bin/tmux" -V | sed -E 's/^tmux //')
fi

installed_byobu_version=""
if [[ -x "$INSTALL_PREFIX/bin/byobu" ]]; then
    installed_byobu_version=$(
        BYOBU_PREFIX="$INSTALL_PREFIX" "$INSTALL_PREFIX/bin/byobu" --version |
            sed -n -E 's/^byobu version //p' |
            head -n 1
    )
fi

build_required=true
if [[ "$FORCE" == false && "$installed_tmux_version" == "$TMUX_VERSION" && \
      "$installed_byobu_version" == "$BYOBU_VERSION" ]]; then
    if [[ "$ENABLE_TRUSTMUX" == false || -x "$INSTALL_PREFIX/bin/trustmux" ]]; then
        build_required=false
    fi
fi

build_directory=""
staged_tmux=""
direct_socket=""
byobu_socket=""

cleanup() {
    if [[ -n "$direct_socket" && -x "${staged_tmux:-}" ]]; then
        "$staged_tmux" -L "$direct_socket" kill-server 2>/dev/null || true
    fi
    if [[ -n "$byobu_socket" && -x "${staged_tmux:-}" ]]; then
        "$staged_tmux" -L "$byobu_socket" kill-server 2>/dev/null || true
    fi
    if [[ -n "$build_directory" && -d "$build_directory" ]]; then
        case "$build_directory" in
            "${TMPDIR:-/tmp}"/dotfiles-multiplexer.*)
                rm -rf -- "$build_directory"
                ;;
            *)
                error "Refusing to remove unexpected build directory: $build_directory"
                ;;
        esac
    fi
}
trap cleanup EXIT

smoke_test_tmux() {
    local tmux_binary="$1"
    local socket_name="$2"
    local expected_version="$3"

    "$tmux_binary" -L "$socket_name" -f /dev/null \
        new-session -d -s smoke 'sleep 30'
    "$tmux_binary" -L "$socket_name" source-file "$DOTFILES/tmux.conf"
    local actual_version
    actual_version=$("$tmux_binary" -L "$socket_name" display-message -p '#{version}')
    if [[ "$actual_version" != "$expected_version" ]]; then
        error "tmux server version mismatch: expected $expected_version, got $actual_version"
        return 1
    fi
    "$tmux_binary" -L "$socket_name" kill-server
}

if [[ "$build_required" == true ]]; then
    running_tmux_processes=$(running_tmux_servers)
    if [[ -n "$running_tmux_processes" ]]; then
        error "A tmux server is running; refusing an in-place version change"
        process_list="${running_tmux_processes//$'\n'/,}"
        ps -o pid=,args= -p "$process_list" >&2
        exit 1
    fi

    build_directory=$(mktemp -d "${TMPDIR:-/tmp}/dotfiles-multiplexer.XXXXXX")
    tmux_archive="$build_directory/$tmux_asset_name"

    info "Downloading tmux $TMUX_VERSION..."
    curl --fail --location --retry 3 --output "$tmux_archive" "$tmux_asset_url"
    printf '%s  %s\n' "$tmux_asset_sha256" "$tmux_archive" | sha256sum --check -
    tar -xzf "$tmux_archive" -C "$build_directory"
    tmux_source="$build_directory/tmux-$TMUX_VERSION"
    if [[ ! -x "$tmux_source/configure" ]]; then
        error "tmux release did not contain a configure script"
        exit 1
    fi

    info "Resolving Byobu tag $BYOBU_VERSION..."
    expected_byobu_commit=$(
        git ls-remote https://github.com/dustinkirkland/byobu.git \
            "refs/tags/$BYOBU_VERSION" "refs/tags/$BYOBU_VERSION^{}" |
            awk '
                $2 ~ /\^\{\}$/ { peeled_commit = $1 }
                $2 !~ /\^\{\}$/ { tag_commit = $1 }
                END { print peeled_commit != "" ? peeled_commit : tag_commit }
            '
    )
    if [[ -z "$expected_byobu_commit" ]]; then
        error "Byobu tag does not exist: $BYOBU_VERSION"
        exit 1
    fi
    byobu_source="$build_directory/byobu-$BYOBU_VERSION"
    git clone --quiet --depth 1 --branch "$BYOBU_VERSION" \
        https://github.com/dustinkirkland/byobu.git "$byobu_source"
    actual_byobu_commit=$(git -C "$byobu_source" rev-parse HEAD)
    if [[ "$actual_byobu_commit" != "$expected_byobu_commit" ]]; then
        error "Byobu tag commit changed during checkout"
        exit 1
    fi

    tmux_configure_options=(
        "--prefix=$INSTALL_PREFIX"
        --enable-sixel
    )
    if pkg-config --exists libutf8proc; then
        tmux_configure_options+=(--enable-utf8proc)
    fi
    if pkg-config --exists libsystemd; then
        tmux_configure_options+=(--enable-systemd)
    fi

    info "Building tmux $TMUX_VERSION..."
    (
        cd "$tmux_source"
        ./configure "${tmux_configure_options[@]}"
        make -j"$(nproc)"
    )
    staged_tmux="$tmux_source/tmux"
    [[ "$($staged_tmux -V)" == "tmux $TMUX_VERSION" ]]

    direct_socket="multiplexer-stage-tmux-$$"
    smoke_test_tmux "$staged_tmux" "$direct_socket" "$TMUX_VERSION"
    direct_socket=""

    byobu_configure_options=("--prefix=$INSTALL_PREFIX")
    if [[ "$ENABLE_TRUSTMUX" == false ]]; then
        byobu_configure_options+=(--disable-trustmux)
    fi

    info "Building Byobu $BYOBU_VERSION..."
    (
        cd "$byobu_source"
        ./autogen.sh
        ./configure "${byobu_configure_options[@]}"
        make -j"$(nproc)"
    )

    byobu_stage="$build_directory/byobu-stage"
    make -C "$byobu_source" DESTDIR="$byobu_stage" install
    staged_byobu_prefix="$byobu_stage$INSTALL_PREFIX"
    staged_byobu="$staged_byobu_prefix/bin/byobu"
    staged_byobu_version=$(
        BYOBU_PREFIX="$staged_byobu_prefix" \
            PATH="$tmux_source:$staged_byobu_prefix/bin:/usr/bin:/bin" \
            "$staged_byobu" --version |
            sed -n -E 's/^byobu version //p' |
            head -n 1
    )
    if [[ "$staged_byobu_version" != "$BYOBU_VERSION" ]]; then
        error "Staged Byobu version mismatch: $staged_byobu_version"
        exit 1
    fi

    byobu_socket="multiplexer-stage-byobu-$$"
    BYOBU_PREFIX="$staged_byobu_prefix" \
        PATH="$tmux_source:$staged_byobu_prefix/bin:/usr/bin:/bin" \
        "$staged_byobu" -L "$byobu_socket" \
        new-session -d -s smoke 'sleep 30'
    staged_byobu_tmux_version=$(
        "$staged_tmux" -L "$byobu_socket" display-message -p '#{version}'
    )
    if [[ "$staged_byobu_tmux_version" != "$TMUX_VERSION" ]]; then
        error "Staged Byobu used tmux $staged_byobu_tmux_version"
        exit 1
    fi
    "$staged_tmux" -L "$byobu_socket" kill-server
    byobu_socket=""

    backup_directory="${XDG_DATA_HOME:-$HOME/.local/share}/dotfiles/backups/multiplexer-$(date +%Y%m%d-%H%M%S)"
    install -d -m 0755 "$backup_directory/bin"
    if [[ -x "$INSTALL_PREFIX/bin/tmux" ]]; then
        cp -a "$INSTALL_PREFIX/bin/tmux" "$backup_directory/bin/tmux"
    fi
    for staged_binary in "$staged_byobu_prefix"/bin/*; do
        binary_name=$(basename "$staged_binary")
        if [[ -e "$INSTALL_PREFIX/bin/$binary_name" ]]; then
            cp -a "$INSTALL_PREFIX/bin/$binary_name" "$backup_directory/bin/$binary_name"
        fi
    done
    for installed_directory in etc/byobu lib/byobu share/byobu share/doc/byobu; do
        if [[ -d "$INSTALL_PREFIX/$installed_directory" ]]; then
            install -d -m 0755 "$backup_directory/$(dirname "$installed_directory")"
            cp -a "$INSTALL_PREFIX/$installed_directory" \
                "$backup_directory/$installed_directory"
        fi
    done
    info "Backed up the installed stack to $backup_directory"

    info "Installing tmux $TMUX_VERSION and Byobu $BYOBU_VERSION..."
    make -C "$tmux_source" install
    make -C "$byobu_source" install
else
    info "tmux $TMUX_VERSION and Byobu $BYOBU_VERSION are already installed"
fi

update_plugins() {
    local tpm_directory="$PLUGIN_ROOT/tpm"
    install -d -m 0755 "$PLUGIN_ROOT"

    for plugin_directory in "$PLUGIN_ROOT"/*; do
        [[ -d "$plugin_directory/.git" ]] || continue
        if [[ -n "$(git -C "$plugin_directory" status --porcelain)" ]]; then
            error "Plugin repository has local changes: $plugin_directory"
            return 1
        fi
    done

    if [[ -d "$tpm_directory/.git" ]]; then
        git -C "$tpm_directory" remote set-url origin \
            https://github.com/tmux-plugins/tpm.git
        git -C "$tpm_directory" pull --ff-only
    elif [[ -e "$tpm_directory" ]]; then
        error "TPM path exists but is not a Git checkout: $tpm_directory"
        return 1
    else
        git clone https://github.com/tmux-plugins/tpm.git "$tpm_directory"
    fi

    TMUX_PLUGIN_MANAGER_PATH="$PLUGIN_ROOT/" \
        "$tpm_directory/bin/install_plugins"
    TMUX_PLUGIN_MANAGER_PATH="$PLUGIN_ROOT/" \
        "$tpm_directory/bin/update_plugins" all
}

info "Updating TPM and configured plugins..."
update_plugins

installed_tmux_output=$("$INSTALL_PREFIX/bin/tmux" -V)
installed_byobu_output=$(
    BYOBU_PREFIX="$INSTALL_PREFIX" "$INSTALL_PREFIX/bin/byobu" --version
)
if [[ "$installed_tmux_output" != "tmux $TMUX_VERSION" ]]; then
    error "Installed tmux version mismatch: $installed_tmux_output"
    exit 1
fi
if ! grep -qx "byobu version $BYOBU_VERSION" <<< "$installed_byobu_output"; then
    error "Installed Byobu version mismatch"
    exit 1
fi

staged_tmux="$INSTALL_PREFIX/bin/tmux"
direct_socket="multiplexer-installed-tmux-$$"
smoke_test_tmux "$staged_tmux" "$direct_socket" "$TMUX_VERSION"
direct_socket=""

byobu_socket="multiplexer-installed-byobu-$$"
BYOBU_PREFIX="$INSTALL_PREFIX" \
    PATH="$INSTALL_PREFIX/bin:/usr/bin:/bin" \
    "$INSTALL_PREFIX/bin/byobu" -L "$byobu_socket" \
    new-session -d -s smoke 'sleep 30'
installed_byobu_tmux_version=$(
    "$INSTALL_PREFIX/bin/tmux" -L "$byobu_socket" display-message -p '#{version}'
)
if [[ "$installed_byobu_tmux_version" != "$TMUX_VERSION" ]]; then
    error "Installed Byobu used tmux $installed_byobu_tmux_version"
    exit 1
fi
"$INSTALL_PREFIX/bin/tmux" -L "$byobu_socket" kill-server
byobu_socket=""

info "Installed tmux $TMUX_VERSION, Byobu $BYOBU_VERSION, and current plugins"
