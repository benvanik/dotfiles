#!/bin/sh
# Pre-commit hook for dotfiles repository.
# Runs dotfiles test to validate syntax and configuration.
#
# Installation: dotfiles install (automatically links to .git/hooks/)
# Manual: ln -sf ../../git/hooks/pre-commit .git/hooks/pre-commit

set -e

# Resolve the worktree before clearing Git's repository-local environment. A
# managed hook lives in the common Git directory, so resolving relative to $0
# would validate the primary checkout even when another worktree is committing.
DOTFILES="$(git rev-parse --show-toplevel)"

# Hooks inherit repository-local Git paths. Integration tests create their own
# repositories, and those Git commands must discover the fixture repository
# instead of reusing the committing worktree's index and configuration.
git_environment_variables="$(git rev-parse --local-env-vars)"
# Git emits one variable name per line; splitting supplies each name to unset.
# shellcheck disable=SC2086
unset $git_environment_variables
unset git_environment_variables
export DOTFILES

echo "Running dotfiles test..."
if "$DOTFILES/bin/dotfiles" test; then
    echo "Pre-commit checks passed."
else
    echo "Pre-commit checks failed. Fix errors before committing."
    exit 1
fi
