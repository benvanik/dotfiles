#!/usr/bin/python3.12
"""Relocated entrypoint for the content-addressed runtime bundle."""

from __future__ import annotations

import hashlib
import json
import os
import pathlib
import re
import stat
import sys
from typing import Any


MAX_BOOTSTRAP_DOCUMENT_BYTES = 16 * 1024 * 1024
IMPLEMENTATION_BUNDLE_SCHEMA = "runpod.inference-service-implementation-bundle.v1"
IMPLEMENTATION_RECEIPT_SCHEMA = "runpod.inference-service-implementation-receipt.v1"
IMPLEMENTATION_ID = "runpod-inference-service-runtime-v1"
SHA256_PATTERN = re.compile(r"^[0-9a-f]{64}$")

ENTRYPOINT = pathlib.Path(__file__).absolute()
BUNDLE_ROOT = ENTRYPOINT.parents[1]


class BootstrapError(Exception):
    """The installed implementation tree is not its claimed identity."""


def _fail(message: str) -> None:
    raise BootstrapError(message)


def _safe_file_bytes(
    path: pathlib.Path,
    *,
    mode: int,
    maximum_bytes: int,
) -> bytes:
    try:
        before = path.lstat()
    except OSError as error:
        raise BootstrapError(f"implementation file is absent: {path}") from error
    if (
        not stat.S_ISREG(before.st_mode)
        or stat.S_ISLNK(before.st_mode)
        or before.st_uid != os.getuid()
        or before.st_nlink != 1
        or stat.S_IMODE(before.st_mode) != mode
        or not 1 <= before.st_size <= maximum_bytes
    ):
        _fail(f"implementation file has an unsafe identity: {path}")
    flags = os.O_RDONLY | getattr(os, "O_CLOEXEC", 0)
    flags |= getattr(os, "O_NOFOLLOW", 0)
    try:
        descriptor = os.open(path, flags)
    except OSError as error:
        raise BootstrapError(
            f"cannot safely open implementation file: {path}"
        ) from error
    try:
        opened = os.fstat(descriptor)
        if (
            opened.st_dev != before.st_dev
            or opened.st_ino != before.st_ino
            or not stat.S_ISREG(opened.st_mode)
            or opened.st_uid != before.st_uid
            or opened.st_nlink != before.st_nlink
            or opened.st_size != before.st_size
            or stat.S_IMODE(opened.st_mode) != mode
        ):
            _fail(f"implementation file changed while opening: {path}")
        chunks: list[bytes] = []
        remaining = maximum_bytes + 1
        while remaining:
            chunk = os.read(descriptor, min(64 * 1024, remaining))
            if not chunk:
                break
            chunks.append(chunk)
            remaining -= len(chunk)
        payload = b"".join(chunks)
        after = os.fstat(descriptor)
    finally:
        os.close(descriptor)
    if (
        len(payload) != opened.st_size
        or len(payload) > maximum_bytes
        or after.st_dev != opened.st_dev
        or after.st_ino != opened.st_ino
        or after.st_size != opened.st_size
        or after.st_mtime_ns != opened.st_mtime_ns
        or after.st_ctime_ns != opened.st_ctime_ns
        or not stat.S_ISREG(after.st_mode)
        or after.st_uid != opened.st_uid
        or after.st_nlink != opened.st_nlink
        or stat.S_IMODE(after.st_mode) != mode
    ):
        _fail(f"implementation file changed while reading: {path}")
    return payload


def _json_object(payload: bytes, *, label: str) -> dict[str, Any]:
    def reject_duplicates(
        pairs: list[tuple[str, Any]],
    ) -> dict[str, Any]:
        value: dict[str, Any] = {}
        for key, item in pairs:
            if key in value:
                _fail(f"{label} repeats field {key!r}")
            value[key] = item
        return value

    try:
        value = json.loads(
            payload,
            object_pairs_hook=reject_duplicates,
        )
    except (UnicodeDecodeError, json.JSONDecodeError) as error:
        raise BootstrapError(f"{label} is not valid JSON") from error
    if not isinstance(value, dict):
        _fail(f"{label} is not an object")
    return value


def _manifest_argument() -> pathlib.Path:
    malformed = [
        argument
        for argument in sys.argv[1:]
        if argument.startswith("--manifest") and argument != "--manifest"
    ]
    if malformed:
        _fail("runtime manifest option must use one exact two-argument spelling")
    positions = [
        position
        for position, argument in enumerate(sys.argv[1:], start=1)
        if argument == "--manifest"
    ]
    if len(positions) != 1 or positions[0] + 1 >= len(sys.argv):
        _fail("runtime invocation has no unique manifest argument")
    value = sys.argv[positions[0] + 1]
    path = pathlib.Path(value)
    if (
        not path.is_absolute()
        or str(path) != os.path.normpath(str(path))
        or "\x00" in value
    ):
        _fail("runtime manifest argument is not absolute and normalized")
    return path


def _relative_bundle_path(value: Any) -> pathlib.PurePosixPath:
    if not isinstance(value, str):
        _fail("implementation member path is not a string")
    path = pathlib.PurePosixPath(value)
    if (
        not value
        or path.is_absolute()
        or str(path) != value
        or any(part in {"", ".", ".."} for part in path.parts)
        or "\\" in value
    ):
        _fail("implementation member path is unsafe")
    return path


def _canonical_bytes(value: Any) -> bytes:
    return (
        json.dumps(
            value,
            sort_keys=True,
            separators=(",", ":"),
            ensure_ascii=True,
        )
        + "\n"
    ).encode("ascii")


def _require_private_directory(path: pathlib.Path) -> None:
    try:
        metadata = path.lstat()
    except OSError as error:
        raise BootstrapError(f"implementation directory is absent: {path}") from error
    if (
        not stat.S_ISDIR(metadata.st_mode)
        or stat.S_ISLNK(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) != 0o700
    ):
        _fail(f"implementation directory has an unsafe identity: {path}")


def _verify_exact_tree(expected_files: set[pathlib.Path]) -> None:
    expected_directories = {BUNDLE_ROOT}
    for path in expected_files:
        expected_directories.update(
            parent
            for parent in path.parents
            if parent == BUNDLE_ROOT or BUNDLE_ROOT in parent.parents
        )
    observed_files: set[pathlib.Path] = set()
    observed_directories: set[pathlib.Path] = set()
    for directory, directory_names, file_names in os.walk(
        BUNDLE_ROOT,
        topdown=True,
        followlinks=False,
    ):
        directory_path = pathlib.Path(directory)
        observed_directories.add(directory_path)
        for name in directory_names:
            child = directory_path / name
            metadata = child.lstat()
            if not stat.S_ISDIR(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
                _fail(f"implementation tree contains a non-directory entry: {child}")
        for name in file_names:
            child = directory_path / name
            metadata = child.lstat()
            if not stat.S_ISREG(metadata.st_mode) or stat.S_ISLNK(metadata.st_mode):
                _fail(f"implementation tree contains a non-regular file: {child}")
            observed_files.add(child)
    if observed_files != expected_files or observed_directories != expected_directories:
        _fail("implementation tree does not match its exact receipt")
    for directory in observed_directories:
        _require_private_directory(directory)


def verify_bundle_before_import() -> None:
    """Bind the imported Python tree to deployment.json before importing it."""

    manifest_path = _manifest_argument()
    manifest_payload = _safe_file_bytes(
        manifest_path,
        mode=0o600,
        maximum_bytes=MAX_BOOTSTRAP_DOCUMENT_BYTES,
    )
    manifest = _json_object(
        manifest_payload,
        label="deployment manifest",
    )
    implementation = manifest.get("implementation")
    if not isinstance(implementation, dict):
        _fail("deployment manifest has no implementation binding")
    receipt_binding = implementation.get("receipt")
    if not isinstance(receipt_binding, dict):
        _fail("deployment manifest has no implementation receipt binding")
    bundle_sha256 = implementation.get("bundle_sha256")
    if (
        not isinstance(bundle_sha256, str)
        or SHA256_PATTERN.fullmatch(bundle_sha256) is None
        or BUNDLE_ROOT.name != bundle_sha256
        or implementation.get("remote_root") != str(BUNDLE_ROOT)
        or implementation.get("entrypoint") != str(ENTRYPOINT)
    ):
        _fail("deployment implementation path is not its claimed identity")
    receipt_path = BUNDLE_ROOT / "bundle.json"
    if (
        receipt_binding.get("remote_path") != str(receipt_path)
        or not isinstance(receipt_binding.get("bytes"), int)
        or isinstance(receipt_binding.get("bytes"), bool)
        or not 1 <= receipt_binding["bytes"] <= 1024 * 1024
        or not isinstance(receipt_binding.get("sha256"), str)
        or SHA256_PATTERN.fullmatch(receipt_binding["sha256"]) is None
    ):
        _fail("deployment implementation receipt binding is malformed")
    receipt_payload = _safe_file_bytes(
        receipt_path,
        mode=0o600,
        maximum_bytes=1024 * 1024,
    )
    if (
        len(receipt_payload) != receipt_binding["bytes"]
        or hashlib.sha256(receipt_payload).hexdigest() != receipt_binding["sha256"]
    ):
        _fail("implementation receipt bytes do not match the deployment")
    receipt = _json_object(
        receipt_payload,
        label="implementation receipt",
    )
    if (
        set(receipt)
        != {
            "schema_version",
            "bundle_sha256",
            "implementation",
        }
        or receipt.get("schema_version") != IMPLEMENTATION_RECEIPT_SCHEMA
    ):
        _fail("implementation receipt schema is unsupported")
    identity = receipt["implementation"]
    if (
        receipt.get("bundle_sha256") != bundle_sha256
        or not isinstance(identity, dict)
        or identity.get("schema_version") != IMPLEMENTATION_BUNDLE_SCHEMA
        or identity.get("implementation_id") != IMPLEMENTATION_ID
        or identity.get("relative_entrypoint") != "bin/runpod-service-runtime"
        or hashlib.sha256(_canonical_bytes(identity)).hexdigest() != bundle_sha256
    ):
        _fail("implementation receipt does not derive the bundle identity")
    records = identity.get("files")
    if not isinstance(records, list) or not records:
        _fail("implementation receipt has no member closure")
    expected_files = {receipt_path}
    observed_relative: set[str] = set()
    for record in records:
        if not isinstance(record, dict) or set(record) != {
            "bundle_path",
            "mode",
            "bytes",
            "sha256",
        }:
            _fail("implementation receipt member is malformed")
        relative = _relative_bundle_path(record["bundle_path"])
        relative_text = str(relative)
        if relative_text in observed_relative or relative_text == "bundle.json":
            _fail("implementation receipt repeats a member")
        observed_relative.add(relative_text)
        mode_text = record["mode"]
        byte_count = record["bytes"]
        digest = record["sha256"]
        if (
            mode_text not in {"0644", "0755"}
            or not isinstance(byte_count, int)
            or isinstance(byte_count, bool)
            or not 1 <= byte_count <= 1024 * 1024
            or not isinstance(digest, str)
            or SHA256_PATTERN.fullmatch(digest) is None
        ):
            _fail("implementation receipt member identity is malformed")
        member_path = BUNDLE_ROOT.joinpath(*relative.parts)
        payload = _safe_file_bytes(
            member_path,
            mode=int(mode_text, 8),
            maximum_bytes=1024 * 1024,
        )
        if len(payload) != byte_count or hashlib.sha256(payload).hexdigest() != digest:
            _fail(f"implementation member bytes do not match: {relative_text}")
        expected_files.add(member_path)
    if ENTRYPOINT not in expected_files:
        _fail("implementation receipt does not include its entrypoint")
    _verify_exact_tree(expected_files)


sys.dont_write_bytecode = True
try:
    verify_bundle_before_import()
except BootstrapError as error:
    print(
        json.dumps(
            {
                "schema_version": "runpod.inference-service-error.v1",
                "error": "invalid_service_runtime_implementation",
                "message": str(error),
            },
            sort_keys=True,
        ),
        file=sys.stderr,
    )
    raise SystemExit(1) from error

sys.path.insert(0, str(BUNDLE_ROOT))
from service_runtime.controller import main  # noqa: E402


raise SystemExit(main(invoked_entrypoint=ENTRYPOINT))
