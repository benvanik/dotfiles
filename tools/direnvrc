# Versioned tools for direnv.
# Link to ~/.direnvrc or source from ~/.config/direnv/direnvrc.

# direnv does not automatically watch its global rc file. Track the canonical
# repository source so a pull that changes loader semantics invalidates every
# project environment that uses it.
if ! watch_file "${HOME}/.dotfiles/tools/direnvrc"; then
    log_error "Could not watch the dotfiles direnv loader"
    return 1
fi

# direnv's source_env performs directory cleanup after sourcing a file. That
# cleanup can turn a rejected environment file into a successful source. These
# files do not need source_env's directory switching, so source them directly
# and leave the source operation as the function's terminal status.
_source_checked_environment() {
    local environment_file="$1"
    case "$environment_file" in
        /*|./*|../*) ;;
        *) environment_file="./$environment_file" ;;
    esac
    watch_file "$environment_file" || return 1
    # shellcheck disable=SC1090
    . "$environment_file"
}
_DIRENV_CHECKED_ENVIRONMENT_IMPORTS=1

if ! _source_checked_environment \
        "${HOME}/.dotfiles/tools/platform.sh"; then
    log_error "Could not load dotfiles platform helpers"
    return 1
fi
if ! _source_checked_environment \
        "${HOME}/.dotfiles/tools/versions.sh"; then
    log_error "Could not load dotfiles version helpers"
    return 1
fi

# Track active tools for summary output.
_DIRENV_TOOLS=""

# Add tool to active list (called by _use_tool).
_track_tool() {
    local tool="$1" version="$2"
    local tracked_tool=""
    local retained_tools=""

    # shellcheck disable=SC2086
    for tracked_tool in $_DIRENV_TOOLS; do
        case "$tracked_tool" in
            "$tool":*) continue ;;
        esac
        retained_tools="${retained_tools:+$retained_tools }$tracked_tool"
    done
    _DIRENV_TOOLS="${retained_tools:+$retained_tools }$tool:$version"
}

# Generic tool loader.
# Args: tool, requirement.
_use_tool() {
    local tool="$1" requirement="${2:-latest}"

    # Silent skip if platform doesn't support.
    _platform_supports "$tool" || return 0

    local tool_dir="${HOME}/tools/${tool}"
    local tool_path

    if ! tool_path=$(_find_version "$tool_dir" "$requirement"); then
        log_error "No ${tool} version matching '${requirement}' found in ${tool_dir}"
        return 1
    fi

    # Environment definitions are tracked with the dotfiles so pulling an
    # update changes behavior without reinstalling the tool payload.
    local environment_file="${HOME}/.dotfiles/tools/${tool}/env.sh"
    if [ ! -f "$environment_file" ]; then
        log_error "Missing ${tool} environment definition: ${environment_file}"
        return 1
    fi

    # Export root variable for env.sh to use.
    local root_var
    local previous_root=""
    local previous_root_set=""
    root_var="$(echo "${tool}" | tr '[:lower:]' '[:upper:]')_ROOT"
    eval "previous_root=\${$root_var-}"
    eval "previous_root_set=\${$root_var+x}"
    export "$root_var=$tool_path"

    # Keep this source as a bare command. Generated project environments enable
    # errexit, and placing the source in a conditional would disable strict
    # evaluation throughout the imported file.
    local activation_status=0
    _source_checked_environment "$environment_file"
    activation_status=$?
    if [ "$activation_status" -ne 0 ]; then
        if [ "$previous_root_set" = "x" ]; then
            export "$root_var=$previous_root"
        else
            unset "$root_var"
        fi
        log_error "Could not activate ${tool} from ${tool_path}"
        return 1
    fi

    # Track for summary output.
    _track_tool "$tool" "$(_version_from_path "$tool_path")"
}

# Tool-specific functions.
use_bazel() { _use_tool "bazel" "${1:-latest}"; }
use_cmake() { _use_tool "cmake" "${1:-latest}"; }
use_cuda() { _use_tool "cuda" "${1:-latest}"; }
use_llvm() { _use_tool "llvm" "${1:-latest}"; }
use_mold() { _use_tool "mold" "${1:-latest}"; }
use_ninja() { _use_tool "ninja" "${1:-latest}"; }
use_rocm() { _use_tool "rocm" "${1:-latest}"; }
use_vulkan() { _use_tool "vulkan" "${1:-latest}"; }

# Activate a Nix flake devshell with caching.
#
# Projects with a flake.nix declare their development dependencies declaratively.
# This function evaluates the flake once and caches the resulting environment.
# Subsequent directory entries are instant (reads from cache). The cache
# invalidates automatically when flake.nix or flake.lock change.
#
# Usage: use_flake
#
# Requires nix (install with: ~/.dotfiles/tools/nix/install.sh).
use_flake() {
    # Find nix binary.
    local nix=""
    if command -v nix &>/dev/null; then
        nix="nix"
    elif [ -x /nix/var/nix/profiles/default/bin/nix ]; then
        nix="/nix/var/nix/profiles/default/bin/nix"
    else
        log_error "nix not found (install with: ~/.dotfiles/tools/nix/install.sh)"
        return 1
    fi

    # Must have a flake.nix in the current directory.
    if [ ! -f flake.nix ]; then
        log_error "use_flake: no flake.nix in $(pwd)"
        return 1
    fi

    # Tell direnv to re-evaluate when flake inputs change.
    watch_file flake.nix
    watch_file flake.lock

    # Cache directory keyed by project path.
    local project_hash
    project_hash="$(printf '%s' "$PWD" | git hash-object --stdin)"
    local cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/direnv/flake/${project_hash}"
    mkdir -p "$cache_dir"

    # Cache key from flake input content. If flake.lock doesn't exist yet
    # (fresh flake), hash flake.nix alone.
    local input_hash
    input_hash="$(
        {
            cat flake.nix
            [ ! -f flake.lock ] || cat flake.lock
        } | git hash-object --stdin
    )"
    local cache_file="${cache_dir}/${input_hash}.env"

    if [ ! -f "$cache_file" ]; then
        # Print directly to stderr to bypass DIRENV_LOG_FORMAT suppression,
        # since this operation takes several seconds and silence is confusing.
        printf '\033[0;33m[nix]\033[0m evaluating flake devshell (cached after first run)...\n' >&2
        if ! "$nix" print-dev-env --accept-flake-config 2>/dev/null > "${cache_file}.tmp"; then
            [ ! -e "${cache_file}.tmp" ] || unlink "${cache_file}.tmp"
            log_error "nix print-dev-env failed"
            return 1
        fi
        mv "${cache_file}.tmp" "$cache_file"

        # Remove stale cache entries for this project.
        find "$cache_dir" -name "*.env" ! -name "${input_hash}.env" -delete 2>/dev/null || true
    fi

    # Save variables that nix's stdenv setup clobbers with build-time values.
    # These are for Nix's build sandbox, not for interactive development.
    local old_nix_build_top="${NIX_BUILD_TOP:-}"
    local old_tmp="${TMP:-}"
    local old_tmpdir="${TMPDIR:-}"
    local old_temp="${TEMP:-}"
    local old_tempdir="${TEMPDIR:-}"
    local old_xdg_data_dirs="${XDG_DATA_DIRS:-}"

    # Evaluate the cached environment script directly. The nix print-dev-env
    # output saves the current PATH at the top (nix_saved_PATH="$PATH") and
    # appends it at the bottom (PATH="...nix paths...:$nix_saved_PATH"), so
    # evaluating in the direnv context correctly merges nix paths with the
    # user's existing PATH.
    eval "$(< "$cache_file")"

    # Restore clobbered variables. Nix stdenv sets these to
    # build-sandbox paths (NIX_BUILD_TOP, etc.) that are meaningless
    # in a dev shell. Restore the pre-eval values, but default temp
    # dirs to /tmp if the originals were empty — an empty TMPDIR
    # causes tools (notably git's SSH signing) to construct paths
    # rooted at "/" which fails with Permission denied.
    export NIX_BUILD_TOP="$old_nix_build_top"
    export TMP="${old_tmp:-/tmp}"
    export TMPDIR="${old_tmpdir:-/tmp}"
    export TEMP="${old_temp:-/tmp}"
    export TEMPDIR="${old_tempdir:-/tmp}"
    if [ -n "$old_xdg_data_dirs" ]; then
        export XDG_DATA_DIRS="$old_xdg_data_dirs"
    fi

    _track_tool "nix" "flake"
}

# Override Vulkan validation layers (use after use_vulkan).
# Supports: "debug", "release", or path to custom layers.
use_vulkan_layers() {
    local variant="${1:-debug}"
    local vulkan_dir="$HOME/tools/vulkan"
    local layers_path

    case "$variant" in
        debug|release)
            layers_path="$vulkan_dir/$variant"
            ;;
        *)
            # Assume it's a path.
            layers_path="$variant"
            ;;
    esac

    if [ ! -d "$layers_path/share/vulkan/explicit_layer.d" ] ||
       [ ! -d "$layers_path/lib" ]; then
        log_error "Vulkan layers '$variant' not found at $layers_path"
        log_error "Build with: vulkan-build-layers"
        return 1
    fi

    # VK_LAYER_PATH replaces default layer search path.
    export VK_LAYER_PATH="$layers_path/share/vulkan/explicit_layer.d"
    _replace_managed_path_entry \
        LD_LIBRARY_PATH \
        "${layers_path}/lib" \
        DOTFILES_VULKAN_LAYERS_LIBRARY_ENTRY || return 1

    _track_tool "vk-layers" "$variant"
}

# Add repository-local build helpers when the project follows the common
# build_tools/bin layout. Watching the path makes a later checkout that creates
# or removes the directory invalidate direnv's cached environment.
use_project_build_tools() {
    local project_build_tools_directory="$PWD/build_tools/bin"

    watch_file "$project_build_tools_directory" || return 1
    if [ -d "$project_build_tools_directory" ]; then
        PATH_add "$project_build_tools_directory"
    fi
}

# Set per-project history directory.
# Usage: use_project_history [history_dir]
#
# This sets HISTORY_BASE for zsh's per-directory-history plugin.
# History is stored per-directory within HISTORY_BASE.
#
# Examples:
#   use_project_history                    # .history/ in current dir
#   use_project_history "$PWD/../.history" # Share across worktrees
use_project_history() {
    local history_dir="${1:-$PWD/.history}"
    local history_base

    mkdir -p -- "$history_dir" || return 1
    history_base=$(CDPATH='' cd -- "$history_dir" && pwd -P) || return 1
    export HISTORY_BASE="$history_base"
}

# Activate Python virtual environment if present.
# Usage: use_venv [path]
#
# Looks for venv in order: $1, .venv/, venv/
# Silently skips if no venv found (allows .envrc to be portable).
#
# Examples:
#   use_venv              # Auto-detect .venv/ or venv/
#   use_venv ".venv"      # Explicit path
#
use_venv() {
    local venv_path="${1:-}"

    # Auto-detect if not specified.
    if [ -z "$venv_path" ]; then
        if [ -d ".venv" ]; then
            venv_path=".venv"
        elif [ -d "venv" ]; then
            venv_path="venv"
        else
            # No venv found - silently skip.
            return 0
        fi
    fi

    # Verify venv exists.
    if [ ! -f "${venv_path}/bin/activate" ]; then
        log_error "venv not found at ${venv_path}"
        return 1
    fi

    # Activate venv using direnv's layout mechanism.
    local virtual_environment
    virtual_environment=$(cd "$venv_path" && pwd) || return 1
    export VIRTUAL_ENV="$virtual_environment"
    PATH_add "${VIRTUAL_ENV}/bin"
    export VIRTUAL_ENV_PROMPT="${venv_path##*/}"

    _track_tool "venv" "${venv_path##*/}"
}

# Source .envrc.local if exists (for machine-specific overrides).
# Also prints the environment summary.
source_local_envrc() {
    local source_status=0

    if [ ! -f ".envrc.local" ]; then
        _print_env_summary
        return
    fi

    # Keep this source outside a conditional so a nonterminal failure in the
    # user-owned override aborts a strict direnv evaluation immediately.
    _source_checked_environment ".envrc.local"
    source_status=$?
    if [ "$source_status" -ne 0 ]; then
        log_error "Could not load .envrc.local"
        return 1
    fi
    _print_env_summary
}

# Print a clean one-line summary of active tools.
_print_env_summary() {
    [ -z "$_DIRENV_TOOLS" ] && return

    # Format: [env] llvm:21.1.6 cmake:4.2.0 ninja:1.13.2
    printf '\033[0;36m[env]\033[0m %s\n' "$_DIRENV_TOOLS" >&2
}
